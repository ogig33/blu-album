meta {
  name: S28 Add to playlist options (album)
  type: http
  seq: 90
}

get {
  url: http://{{host}}:11000/AddToPlaylistOptions
  body: none
  auth: none
}

settings {
  encodeUrl: false
}

script:pre-request {
  const H = "http://" + bru.getEnvVar("host") + ":11000";
  const H80 = "http://" + bru.getEnvVar("host") + ":80";
  const al = bru.getVar("vsAlbum");
  if (!al) { bru.runner.skipRequest(); return; }
  req.setUrl(H + "/AddToPlaylistOptions?service=LocalMusic&album=" + encodeURIComponent(al) + "&artist=" + encodeURIComponent(bru.getVar("vsArtist")));
}

script:post-response {
  const body = String(res.getBody() || "");
  const dec = (v) => v.replace(/&amp;/g, "&").replace(/&quot;/g, '"').replace(/&#39;/g, "'").replace(/&lt;/g, "<").replace(/&gt;/g, ">");
  const attr = (tag, n) => { const m = tag.match(new RegExp("\\s" + n + '="([^"]*)"')); return m ? dec(m[1]) : ""; };
  const tags = (name) => body.match(new RegExp("<" + name + "\\b[^>]*>", "g")) || [];
  const val = (tag) => { const m = body.match(new RegExp("<" + tag + ">([^<]*)</" + tag + ">")); return m ? dec(m[1]) : ""; };
  const setting = (name) => tags("setting").find((t) => attr(t, "name") === name) || "";
  console.log("HTTP " + res.getStatus() + "\n" + body.slice(0, 3000));
  const params = (body.match(/<requestParameter>([^<]*)<\/requestParameter>/g) || []).map((x) => dec(x.replace(/<\/?requestParameter>/g, "")));
  bru.setVar("vsAddUrl", val("urlPath") + "?" + params.join("&"));
}

tests {
  const body = String(res.getBody() || "");
  const dec = (v) => v.replace(/&amp;/g, "&").replace(/&quot;/g, '"').replace(/&#39;/g, "'").replace(/&lt;/g, "<").replace(/&gt;/g, ">");
  const attr = (tag, n) => { const m = tag.match(new RegExp("\\s" + n + '="([^"]*)"')); return m ? dec(m[1]) : ""; };
  const tags = (name) => body.match(new RegExp("<" + name + "\\b[^>]*>", "g")) || [];
  const val = (tag) => { const m = body.match(new RegExp("<" + tag + ">([^<]*)</" + tag + ">")); return m ? dec(m[1]) : ""; };
  const setting = (name) => tags("setting").find((t) => attr(t, "name") === name) || "";
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));
  test("has urlPath", () => expect(val("urlPath")).to.not.equal(""));
}
