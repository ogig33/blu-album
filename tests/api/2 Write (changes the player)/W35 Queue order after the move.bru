meta {
  name: W35 Queue order after the move
  type: http
  seq: 134
}

get {
  url: http://{{host}}:11000/Playlist?start=0&end=199
  body: none
  auth: none
}

settings {
  encodeUrl: false
}

script:pre-request {
  if (!bru.getVar("vmOrder")) bru.runner.skipRequest();
}

tests {
  const body = String(res.getBody() || "");
  const dec = (v) => v.replace(/&amp;/g, "&").replace(/&quot;/g, '"').replace(/&#39;/g, "'").replace(/&lt;/g, "<").replace(/&gt;/g, ">");
  // Queue entries in order: the content of every <song> without its id (same song = same text)
  const songs = (xml) => [...xml.matchAll(/<song [^>]*>([\s\S]*?)<\/song>/g)].map((m) => dec(m[1]).replace(/\s+/g, " ").trim());
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));
  const before = JSON.parse(bru.getVar("vmOrder") || "[]"), want = [...before];
  // new = position afterwards: entry 0 is taken out and inserted at index 3
  want.splice(3, 0, want.splice(0, 1)[0]);
  test("entry 0 is now at position 3, entries 1–3 moved up by one", () => expect(songs(body)).to.deep.equal(want));
  test("queue id (pid) changed", () => expect((body.match(/<playlist [^>]*id="(\d+)"/) || [])[1]).to.not.equal(bru.getVar("vmPid")));
}
