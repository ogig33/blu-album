meta {
  name: W34 Move entry 0 to position 3
  type: http
  seq: 133
}

get {
  url: http://{{host}}:11000/Move?new=3&old=0
  body: none
  auth: none
}

settings {
  encodeUrl: false
}

script:pre-request {
  const axios = require("axios");
  const H = "http://" + bru.getEnvVar("host") + ":11000";
  const get = async (p) => String((await axios.get(H + p, { responseType: "text", transformResponse: (x) => x, validateStatus: () => true, timeout: 15000, headers: { "Accept-Language": "en" } })).data || "");
  const dec = (v) => v.replace(/&amp;/g, "&").replace(/&quot;/g, '"').replace(/&#39;/g, "'").replace(/&lt;/g, "<").replace(/&gt;/g, ">");
  // Queue entries in order: the content of every <song> without its id (same song = same text)
  const songs = (xml) => [...xml.matchAll(/<song [^>]*>([\s\S]*?)<\/song>/g)].map((m) => dec(m[1]).replace(/\s+/g, " ").trim());
  // Queue before the move (W34–W37 change only the order and restore it; independent of W16)
  const xml = await get("/Playlist?start=0&end=199");
  const list = songs(xml);
  bru.setVar("vmOrder", "");
  if (list.length < 5 || +((xml.match(/<playlist [^>]*length="(\d+)"/) || [])[1] || 0) > 200) {
    console.log("Fewer than 5 or more than 200 queue entries – skipped");
    bru.runner.skipRequest();
    return;
  }
  bru.setVar("vmOrder", JSON.stringify(list));
  bru.setVar("vmPid", (xml.match(/<playlist [^>]*id="(\d+)"/) || [])[1] || "");
}

tests {
  const body = String(res.getBody() || "");
  const dec = (v) => v.replace(/&amp;/g, "&").replace(/&quot;/g, '"').replace(/&#39;/g, "'").replace(/&lt;/g, "<").replace(/&gt;/g, ">");
  // Queue entries in order: the content of every <song> without its id (same song = same text)
  const songs = (xml) => [...xml.matchAll(/<song [^>]*>([\s\S]*?)<\/song>/g)].map((m) => dec(m[1]).replace(/\s+/g, " ").trim());
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));
  test("answer <moved>", () => expect(/<moved>/.test(body)).to.equal(true));
}
