meta {
  name: W24 Favourite songs contain the song
  type: http
  seq: 123
}

get {
  url: http://{{host}}:11000/Browse
  body: none
  auth: none
}

settings {
  encodeUrl: false
}

script:pre-request {
  if (bru.getVar("vaSkip") === "1") { bru.runner.skipRequest(); return; }
  if (!bru.getVar("vaFavFn") || !bru.getVar("vaFavSongsKey")) { bru.runner.skipRequest(); return; }
  req.setUrl("http://" + bru.getEnvVar("host") + ":11000/Browse?key=" + encodeURIComponent(bru.getVar("vaFavSongsKey")));
}

script:post-response {
  const axios = require("axios");
  const H = "http://" + bru.getEnvVar("host") + ":11000";
  const get = async (p) => String((await axios.get(H + p, { responseType: "text", transformResponse: (x) => x, validateStatus: () => true, timeout: 15000, headers: { "Accept-Language": "en" } })).data || "");
  const dec = (v) => v.replace(/&amp;/g, "&").replace(/&quot;/g, '"').replace(/&#39;/g, "'").replace(/&lt;/g, "<").replace(/&gt;/g, ">");
  const attr = (tag, n) => { const m = tag.match(new RegExp("\\s" + n + '="([^"]*)"')); return m ? dec(m[1]) : ""; };
  const tagsOf = (xml, name) => xml.match(new RegExp("<" + name + "\\b[^>]*>", "g")) || [];
  const browse = (key) => get("/Browse?key=" + encodeURIComponent(key));
  const param = (u, n) => { const m = u.match(new RegExp("[?&]" + n + "=([^&]*)")); return m ? decodeURIComponent(m[1].replace(/\+/g, " ")) : ""; };
  const body = String(res.getBody() || "");
  // The song in the favourite list (by its file) and the remove action of its context menu
  const fileOf = (t) => param(attr(t, "playURL"), "file");
  const song = tagsOf(body, "item").find((t) => fileOf(t) === bru.getVar("vaFavFn"));
  const del = song ? tagsOf(await browse(attr(song, "contextMenuKey")), "item").find((t) => attr(t, "type") === "favourite-delete") : "";
  bru.setVar("vaUnfavUrl", del ? attr(del, "actionURL") : "");
  console.log("'" + bru.getVar("vaFavTitle") + "' in the favourite songs: " + !!song + "\nremove action: " + bru.getVar("vaUnfavUrl"));
}

tests {
  const body = String(res.getBody() || "");
  const val = (t) => { const m = body.match(new RegExp("<" + t + ">([^<]*)</" + t + ">")); return m ? m[1] : ""; };
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));
  test("the song is a favourite now", () => expect(bru.getVar("vaUnfavUrl")).to.not.equal(""));
  test("its menu removes it with /DeleteFavourite?fn=", () => expect(/^\/DeleteFavourite\?(.*&)?fn=/.test(bru.getVar("vaUnfavUrl"))).to.equal(true));
}
