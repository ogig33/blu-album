meta {
  name: S33 Player has the test name
  type: http
  seq: 95
}

get {
  url: http://{{host}}:11000/Name
  body: none
  auth: none
}

settings {
  encodeUrl: false
}

script:pre-request {
  const H = "http://" + bru.getEnvVar("host") + ":11000";
  if (!bru.getVar("vsName")) { bru.runner.skipRequest(); return; }
  await new Promise((r) => setTimeout(r, 1000));
}

script:post-response {
  const body = String(res.getBody() || "");
  const name = (body.match(/<name>([^<]*)<\/name>/) || [])[1] || "";
  console.log(body);

}

tests {
  const body = String(res.getBody() || "");
  const name = (body.match(/<name>([^<]*)<\/name>/) || [])[1] || "";
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));
  test("name changed", () => expect(name.replace(/&amp;/g, "&")).to.equal(bru.getVar("vsName") + " test"));
}
