meta {
  name: W16 Remember state and save the queue
  type: http
  seq: 115
}

get {
  url: http://{{host}}:11000/Save?name=__bluos_verify_add__
  body: none
  auth: none
}

settings {
  encodeUrl: false
}

script:pre-request {
  const axios = require("axios");
  const H = "http://" + bru.getEnvVar("host") + ":11000";
  const get = async (p) => String((await axios.get(H + p, { responseType: "text", transformResponse: (x) => x, validateStatus: () => true, timeout: 15000, headers: { "Accept-Language": "en" } })).data || "");
  const dec = (v) => v.replace(/&amp;/g, "&").replace(/&quot;/g, '"').replace(/&#39;/g, "'").replace(/&lt;/g, "<").replace(/&gt;/g, ">");
  const attr = (tag, n) => { const m = tag.match(new RegExp("\\s" + n + '="([^"]*)"')); return m ? dec(m[1]) : ""; };
  const tagsOf = (xml, name) => xml.match(new RegExp("<" + name + "\\b[^>]*>", "g")) || [];
  const browse = (key) => get("/Browse?key=" + encodeURIComponent(key));
  const param = (u, n) => { const m = u.match(new RegExp("[?&]" + n + "=([^&]*)")); return m ? decodeURIComponent(m[1].replace(/\+/g, " ")) : ""; };
  // Start of W16–W29: autoplayURLs with category / composer / offset and a song favourite (fn=).
  // The queue is saved as playlist __bluos_verify_add__ and restored by W27–W29.
  const s = await get("/Status");
  const v = (t) => { const m = s.match(new RegExp("<" + t + ">([^<]*)</" + t + ">")); return m ? m[1] : ""; };
  const len = attr(tagsOf(await get("/Playlist?start=0&end=0"), "playlist")[0] || "", "length") || "0";
  bru.setVar("vaState", v("state"));
  bru.setVar("vaSong", v("song"));
  bru.setVar("vaSecs", v("secs"));
  bru.setVar("vaLength", len);
  bru.setVar("vaExpect", "");
  if (/<streamUrl>/.test(s) || len === "0") {
    console.log("Not playing from a queue (or the queue is empty) – W16–W29 skipped");
    bru.setVar("vaSkip", "1");
    bru.runner.skipRequest();
    return;
  }
  bru.setVar("vaSkip", "");
}

tests {
  const body = String(res.getBody() || "");
  const val = (t) => { const m = body.match(new RegExp("<" + t + ">([^<]*)</" + t + ">")); return m ? m[1] : ""; };
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));
  test("<saved><entries>N</entries> with N > 0", () => expect(+((body.match(/<entries>(\d+)<\/entries>/) || [])[1] || 0)).to.be.above(0));
}
