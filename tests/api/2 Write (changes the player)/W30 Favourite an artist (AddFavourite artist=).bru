meta {
  name: W30 Favourite an artist (AddFavourite artist=)
  type: http
  seq: 129
}

get {
  url: http://{{host}}:11000/AddFavourite
  body: none
  auth: none
}

settings {
  encodeUrl: false
}

script:pre-request {
  const axios = require("axios");
  const H = "http://" + bru.getEnvVar("host") + ":11000";
  const get = async (p) => String((await axios.get(H + p, { responseType: "text", transformResponse: (x) => x, validateStatus: () => true, timeout: 15000, headers: { "Accept-Language": "en" } })).data || "");
  const dec = (v) => v.replace(/&amp;/g, "&").replace(/&quot;/g, '"').replace(/&#39;/g, "'").replace(/&lt;/g, "<").replace(/&gt;/g, ">");
  const attr = (tag, n) => { const m = tag.match(new RegExp("\\s" + n + '="([^"]*)"')); return m ? dec(m[1]) : ""; };
  const tagsOf = (xml, name) => xml.match(new RegExp("<" + name + "\\b[^>]*>", "g")) || [];
  const browse = (key) => get("/Browse?key=" + encodeURIComponent(key));
  // First artist of the library that is no favourite; its context menu gives /AddFavourite?artist=…
  // (W30–W33 change no queue and run without W16)
  bru.setVar("vfArtist", "");
  const keys = (xml) => tagsOf(xml, "item").map((t) => attr(t, "browseKey")).filter(Boolean);
  const open = async (key) => { let xml = await browse(key); while (/<browse\b[^>]*type="sections"/.test(xml) && keys(xml)[0]) xml = await browse(keys(xml)[0]); return xml; };
  const menu = keys(await browse("LocalMusic:"));
  const favKey = menu.find((k) => /Favourites/.test(k));
  bru.setVar("vfFavArtistsKey", (favKey ? keys(await browse(favKey)) : []).find((k) => /^LocalMusic:Artist\//.test(k)) || "");
  const artistsKey = menu.find((k) => /:Artist\//.test(k));
  const artist = artistsKey ? tagsOf(await open(artistsKey), "item").find((t) => attr(t, "type") === "artist" && attr(t, "contextMenuKey") && !/isFavourite=1/.test(attr(t, "contextMenuKey"))) : "";
  const add = artist ? tagsOf(await browse(attr(artist, "contextMenuKey")), "item").find((t) => attr(t, "type") === "favourite-add") : "";
  const url = add ? attr(add, "actionURL") : "";
  if (!/[?&]artist=/.test(url) || !bru.getVar("vfFavArtistsKey")) { console.log("No artist without favourite, no /AddFavourite?artist= or no favourite artist list – skipped"); bru.runner.skipRequest(); return; }
  bru.setVar("vfArtist", attr(artist, "text"));
  req.setUrl(H + url);
}

script:post-response {
  const body = String(res.getBody() || "");
  // Stores the answer in fixtures/ (needs Developer mode for the JavaScript sandbox)
  if (bru.getEnvVar("saveFixtures") === "true") {
    try {
      const fs = require("fs"), path = require("path");
      const dir = path.join(bru.cwd(), "fixtures");
      fs.mkdirSync(dir, { recursive: true });
      fs.writeFileSync(path.join(dir, "verify-add-favourite-artist.xml"), "<!-- " + req.getUrl().replace(/^https?:\/\/[^/]+/, "") + " -->\n" + body);
    } catch (e) {
      console.log("Fixture not saved (switch the JavaScript sandbox to Developer mode): " + e.message);
    }
  }
  console.log(req.getUrl() + "\n" + body);
}

tests {
  const body = String(res.getBody() || "");
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));
  test("answer <favourite>added</favourite>", () => expect(/<favourite\b[^>]*>added<\/favourite>/.test(body)).to.equal(true));
}
