meta {
  name: W25 Remove the song favourite (DeleteFavourite fn=)
  type: http
  seq: 124
}

get {
  url: http://{{host}}:11000/DeleteFavourite
  body: none
  auth: none
}

settings {
  encodeUrl: false
}

script:pre-request {
  if (bru.getVar("vaSkip") === "1") { bru.runner.skipRequest(); return; }
  if (!bru.getVar("vaUnfavUrl")) { bru.runner.skipRequest(); return; }
  req.setUrl("http://" + bru.getEnvVar("host") + ":11000" + bru.getVar("vaUnfavUrl"));
}

script:post-response {
  const body = String(res.getBody() || "");
  // Stores the answer in fixtures/ (needs Developer mode for the JavaScript sandbox)
  if (bru.getEnvVar("saveFixtures") === "true") {
    try {
      const fs = require("fs"), path = require("path");
      const dir = path.join(bru.cwd(), "fixtures");
      fs.mkdirSync(dir, { recursive: true });
      fs.writeFileSync(path.join(dir, "verify-delete-favourite-song.xml"), "<!-- " + req.getUrl().replace(/^https?:\/\/[^/]+/, "") + " -->\n" + body);
    } catch (e) {
      console.log("Fixture not saved (switch the JavaScript sandbox to Developer mode): " + e.message);
    }
  }
  console.log(req.getUrl() + "\n" + body);
}

tests {
  const body = String(res.getBody() || "");
  const val = (t) => { const m = body.match(new RegExp("<" + t + ">([^<]*)</" + t + ">")); return m ? m[1] : ""; };
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));
  test("answer <favourite>deleted</favourite>", () => expect(/<favourite\b[^>]*>deleted<\/favourite>/.test(body)).to.equal(true));
}
