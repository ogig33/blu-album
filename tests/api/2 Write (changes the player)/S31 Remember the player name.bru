meta {
  name: S31 Remember the player name
  type: http
  seq: 93
}

get {
  url: http://{{host}}:11000/Name
  body: none
  auth: none
}

settings {
  encodeUrl: false
}

script:post-response {
  const body = String(res.getBody() || "");
  const name = (body.match(/<name>([^<]*)<\/name>/) || [])[1] || "";
  console.log(body);
  bru.setVar("vsName", name.replace(/&amp;/g, "&"));
}

tests {
  const body = String(res.getBody() || "");
  const name = (body.match(/<name>([^<]*)<\/name>/) || [])[1] || "";
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));
  test("has a name", () => expect(name).to.not.equal(""));
}
