meta {
  name: W29 Delete the saved queue playlist
  type: http
  seq: 128
}

get {
  url: http://{{host}}:11000/Delete?service=BluOS&name=__bluos_verify_add__
  body: none
  auth: none
}

settings {
  encodeUrl: false
}

script:pre-request {
  if (bru.getVar("vaSkip") === "1") { bru.runner.skipRequest(); return; }
}

script:post-response {
  const axios = require("axios");
  const H = "http://" + bru.getEnvVar("host") + ":11000";
  const get = async (p) => String((await axios.get(H + p, { responseType: "text", transformResponse: (x) => x, validateStatus: () => true, timeout: 15000, headers: { "Accept-Language": "en" } })).data || "");
  const dec = (v) => v.replace(/&amp;/g, "&").replace(/&quot;/g, '"').replace(/&#39;/g, "'").replace(/&lt;/g, "<").replace(/&gt;/g, ">");
  const attr = (tag, n) => { const m = tag.match(new RegExp("\\s" + n + '="([^"]*)"')); return m ? dec(m[1]) : ""; };
  const tagsOf = (xml, name) => xml.match(new RegExp("<" + name + "\\b[^>]*>", "g")) || [];
  const browse = (key) => get("/Browse?key=" + encodeURIComponent(key));
  const param = (u, n) => { const m = u.match(new RegExp("[?&]" + n + "=([^&]*)")); return m ? decodeURIComponent(m[1].replace(/\+/g, " ")) : ""; };
  await new Promise((r) => setTimeout(r, 1000));
  const s = await get("/Status");
  const v = (t) => { const m = s.match(new RegExp("<" + t + ">([^<]*)</" + t + ">")); return m ? m[1] : ""; };
  bru.setVar("vaLengthNow", attr(tagsOf(await get("/Playlist?start=0&end=0"), "playlist")[0] || "", "length"));
  bru.setVar("vaSongNow", v("song"));
  bru.setVar("vaStateNow", v("state"));
  bru.setVar("vaPlaylistsNow", (await get("/Playlists?service=BluOS")).includes(">__bluos_verify_add__<") ? "1" : "");
}

tests {
  const body = String(res.getBody() || "");
  const val = (t) => { const m = body.match(new RegExp("<" + t + ">([^<]*)</" + t + ">")); return m ? m[1] : ""; };
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));
  const playing = (s) => ["play", "stream"].includes(s);
  test("accepted", () => expect(/<error/i.test(body)).to.equal(false));
  test("test playlist is gone", () => expect(bru.getVar("vaPlaylistsNow")).to.equal(""));
  test("queue length as before W16", () => expect(bru.getVar("vaLengthNow")).to.equal(bru.getVar("vaLength")));
  test("queue position as before W16", () => expect(bru.getVar("vaSongNow")).to.equal(bru.getVar("vaSong")));
  test("playing / paused as before W16", () => expect(playing(bru.getVar("vaStateNow"))).to.equal(playing(bru.getVar("vaState"))));
}
