meta {
  name: W27 Load the saved queue
  type: http
  seq: 126
}

get {
  url: http://{{host}}:11000/Load?service=BluOS&name=__bluos_verify_add__
  body: none
  auth: none
}

settings {
  encodeUrl: false
}

script:pre-request {
  if (bru.getVar("vaSkip") === "1") { bru.runner.skipRequest(); return; }
}

tests {
  const body = String(res.getBody() || "");
  const val = (t) => { const m = body.match(new RegExp("<" + t + ">([^<]*)</" + t + ">")); return m ? m[1] : ""; };
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));
  test("accepted", () => expect(/<error/i.test(body)).to.equal(false));
}
