meta {
  name: V12 Settings tree (all menus)
  type: http
  seq: 51
}

get {
  url: http://{{host}}:11000/Settings?schemaVersion=36
  body: none
  auth: none
}

settings {
  encodeUrl: false
}

script:post-response {
  // Reads the whole settings tree: the top level (schema 36, as /SyncStatus reports it), then every
  // menuGroup id (not the settings / buttons) with /Settings?id=<id>, also the ids found in those answers.
  // Only GET /Settings requests – nothing is changed. Needs Developer mode (axios, fixtures).
  const body = String(res.getBody() || "");
  const H = "http://" + bru.getEnvVar("host") + ":11000";
  const ids = (xml) => [...xml.matchAll(/<menuGroup\b[^>]*\sid="([^"]*)"/g)].map((m) => m[1]);
  const urls = (xml) => [...xml.matchAll(/\surl="([^"]*)"/g)].map((m) => m[1].replace(/&amp;/g, "&"));

  const save = (file, text) => {
    if (bru.getEnvVar("saveFixtures") !== "true") return;
    try {
      const fs = require("fs"), path = require("path");
      const dir = path.join(bru.cwd(), "fixtures", "settings");
      fs.mkdirSync(dir, { recursive: true });
      fs.writeFileSync(path.join(dir, file), text);
    } catch (e) {
      console.log("Fixture not saved (switch the JavaScript sandbox to Developer mode): " + e.message);
    }
  };
  save("_top.xml", body);

  const axios = require("axios");
  const done = new Set(), queue = ids(body), found = new Set(urls(body)), pages = [];
  while (queue.length && done.size < 150) {
    const id = queue.shift();
    if (done.has(id)) continue;
    done.add(id);
    try {
      const r = await axios.get(H + "/Settings?schemaVersion=36&id=" + encodeURIComponent(id), { responseType: "text", transformResponse: (x) => x, timeout: 10000 });
      const xml = String(r.data || "");
      if (!/<settings/.test(xml)) continue;
      pages.push(id);
      save(id.replace(/[^\w.-]/g, "_") + ".xml", xml);
      ids(xml).forEach((i) => { if (!done.has(i)) queue.push(i); });
      urls(xml).forEach((u) => found.add(u));
    } catch (e) {
      console.log("id " + id + ": " + e.message);
    }
  }
  const paths = [...new Set([...found].map((u) => u.replace(/^https?:\/\/[^/]+/, "").split("?")[0]))].sort();
  bru.setVar("settingsPages", pages.length);
  save("_summary.txt", "ids asked: " + done.size + "\npages: " + pages.join(", ") + "\n\nendpoints:\n" + paths.join("\n") + "\n\nurls:\n" + [...found].sort().join("\n") + "\n");
  console.log("Settings pages: " + pages.length + " of " + done.size + " ids\nEndpoints: " + paths.join(", "));
}

tests {
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));
  test("top level is a settings tree", () => expect(/<settings/.test(String(res.getBody() || ""))).to.equal(true));
  test("sub pages read", () => expect(bru.getVar("settingsPages")).to.be.above(0));
}
