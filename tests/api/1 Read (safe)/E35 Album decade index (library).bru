meta {
  name: E35 Album decade index (library)
  type: http
  seq: 112
}

get {
  url: http://{{host}}:11000/ui/browseGrouped
  body: none
  auth: none
}

settings {
  encodeUrl: false
}

script:pre-request {
  // Candidate for a decade filter: the album list of the BluOS app sorted by decade (sort menu "Decade",
  // &sort=decade inside the url parameter). The index gives one entry per decade (key "1970", offset,
  // length) instead of letters; albums without a year tag are not in the list. One page of 30. Read only.
  const svc = bru.getVar("libSvc");
  if (!svc) { bru.runner.skipRequest(); return; }
  req.setUrl("http://" + bru.getEnvVar("host") + ":11000/ui/browseGrouped?browseIndex=1&menuGroupId=" + svc + "&service=" + svc + "&title=Albums&type=Album&url=" + encodeURIComponent("/library/v1/Albums?service=" + svc + "&sort=decade"));
}

script:post-response {
  const body = String(res.getBody() || "");
  // Stores the answer in fixtures/ (needs Developer mode for the JavaScript sandbox)
  const saveFixture = (file) => {
    if (bru.getEnvVar("saveFixtures") !== "true") return;
    try {
      const fs = require("fs"), path = require("path");
      const dir = path.join(bru.cwd(), "fixtures");
      fs.mkdirSync(dir, { recursive: true });
      fs.writeFileSync(path.join(dir, file), body);
    } catch (e) {
      console.log("Fixture not saved (switch the JavaScript sandbox to Developer mode): " + e.message);
    }
  };
  saveFixture("explore-35-album-decade-index.xml");
  const idx = [...body.matchAll(/<item key="([^"]*)" offset="(\d+)" length="(\d+)"/g)].map((m) => ({ key: m[1], offset: +m[2], length: +m[3] }));
  // E36 jumps to the last decade
  const last = idx[idx.length - 1];
  bru.setVar("decadeKey", last ? last.key : "");
  bru.setVar("decadeOffset", last ? String(last.offset) : "");
  console.log((body.match(/<list\b[^>]*>/) || [""])[0] + ", " + body.length + " bytes\n" + idx.map((i) => i.key + "s: " + i.length + " (offset " + i.offset + ")").join("\n"));
}

tests {
  const body = String(res.getBody() || "");
  const total = +((body.match(/<list\b[^>]*\btotal="(\d+)"/) || [])[1] || 0);
  const idx = [...body.matchAll(/<item key="([^"]*)" offset="(\d+)" length="(\d+)"/g)].map((m) => ({ key: m[1], offset: +m[2], length: +m[3] }));
  const entries = body.match(/<item\b[^>]*\btitle="[^"]*"[^>]*>[\s\S]*?<\/item>/g) || [];
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));
  test("sort menu: Decade selected", () => expect(/<item text="Decade" selected="true">/.test(body)).to.equal(true));
  test("index keys are decades (four digits ending in 0)", () => {
    expect(idx.length).to.be.above(0);
    idx.forEach((i) => expect(i.key).to.match(/^\d{3}0$/));
  });
  test("index is contiguous and adds up to the total", () => {
    let o = 0;
    idx.forEach((i) => { expect(i.offset).to.equal(o); o += i.length; });
    expect(o).to.equal(total);
  });
  test("first page: at most 30 entries with album, artist and play action", () => {
    expect(entries.length).to.be.above(0);
    expect(entries.length).to.be.at.most(30);
    entries.forEach((e) => {
      expect(e).to.match(/\bsubTitle="[^"]+"/);
      expect(e).to.match(/<playAction\b[^>]*URI="\/Add\?playnow=1/);
    });
  });
  test("next page via listContinuation", () => {
    if (total > entries.length) expect(body).to.match(/<nextLink>[^<]*listContinuation=30/);
  });
}
