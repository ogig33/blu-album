meta {
  name: A28 Playlist tracks
  type: http
  seq: 121
}

get {
  url: http://{{host}}:11000/Browse
  body: none
  auth: none
}

settings {
  encodeUrl: false
}

script:pre-request {
  const key = bru.getVar("playlistKey");
  if (!key) {
    // Needed key not found by an earlier request (A16)
    bru.runner.skipRequest();
    return;
  }
  // Same request as the app (playlist popup): browse key of the first BluOS playlist, without context menu items
  const H = "http://" + bru.getEnvVar("host") + ":11000";
  req.setUrl(H + "/Browse?key=" + encodeURIComponent(key) + "&withContextMenuItems=0");
  // Whether the playlist has a second page (more than 10 tracks): exactly 10 tracks fill the first page without one
  const name = decodeURIComponent((key.split("playlist=")[1] || "").replace(/\+/g, " "));
  const axios = require("axios");
  const next = String((await axios.get(H + "/Songs?service=BluOS&playlist=" + encodeURIComponent(name) + "&offset=10", { responseType: "text", transformResponse: (x) => x, headers: { "Accept-Language": "en" } })).data || "");
  bru.setVar("a28More", /<song\b/.test(next) ? "1" : "0");
}

script:post-response {
  const body = String(res.getBody() || "");

  // Stores the answer in fixtures/ (needs Developer mode for the JavaScript sandbox)
  const saveFixture = (file) => {
    if (bru.getEnvVar("saveFixtures") !== "true") return;
    try {
      const fs = require("fs"), path = require("path");
      const dir = path.join(bru.cwd(), "fixtures");
      fs.mkdirSync(dir, { recursive: true });
      fs.writeFileSync(path.join(dir, file), body);
    } catch (e) {
      console.log("Fixture not saved (switch the JavaScript sandbox to Developer mode): " + e.message);
    }
  };
  saveFixture("28-playlist-tracks.xml");
}

tests {
  const body = String(res.getBody() || "");
  const dec = (v) => v.replace(/&amp;/g, "&").replace(/&quot;/g, '"').replace(/&#39;/g, "'").replace(/&lt;/g, "<").replace(/&gt;/g, ">");
  const attr = (tag, n) => { const m = tag.match(new RegExp("\\s" + n + '="([^"]*)"')); return m ? dec(m[1]) : ""; };
  const tags = (name) => body.match(new RegExp("<" + name + "\\b[^>]*>", "g")) || [];
  const items = (type) => tags("item").filter((t) => !type || attr(t, "type") === type);
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));

  test("type=tracks with the play URL of the playlist", () => {
    const top = tags("browse")[0] || "";
    expect(attr(top, "type")).to.equal("tracks");
    expect(attr(top, "playURL")).to.match(/^\/Load\?service=BluOS&name=/);
  });

  test("tracks have text, text2 (artist • album), duration and autoplayURL of the playlist", () => {
    const t = items("track");
    expect(t.length).to.be.above(0);
    expect(t.length).to.be.at.most(10);
    t.forEach((x) => ["text", "text2", "duration", "autoplayURL"].forEach((n) => expect(attr(x, n), n).to.not.equal("")));
    t.forEach((x, i) => expect(attr(x, "autoplayURL")).to.match(new RegExp("listindex=" + i + "&.*playlist=")));
  });

  test("nextKey (/Songs?playlist=…&offset=10) only with more than 10 tracks", () => {
    const top = tags("browse")[0] || "";
    if (bru.getVar("a28More") === "1") expect(attr(top, "nextKey")).to.match(/^BluOS:Song\/%2FSongs%3Fplaylist=.*&offset=10$/);
    else expect(attr(top, "nextKey")).to.equal("");
  });
}
