meta {
  name: E20 Favourite albums as browse list
  type: http
  seq: 46
}

get {
  url: http://{{host}}:11000/
  body: none
  auth: none
}

settings {
  encodeUrl: false
}

script:pre-request {
  // Candidate for the Favourites chip with the player's URLs (instead of libAlbum()):
  // the /library/v1 request category=FAVOURITES wrapped in a browse key.
  const H = "http://" + bru.getEnvVar("host") + ":11000";

  const svc = bru.getVar("libSvc");
  if (!svc) { bru.runner.skipRequest(); return; }
  req.setUrl(H + "/Browse?withContextMenuItems=1&key=" + encodeURIComponent(svc + ":Album/%2Flibrary%2Fv1%2FAlbums%3Fcategory=FAVOURITES&service=" + svc));
}

script:post-response {
  const body = String(res.getBody() || "");
  const dec = (v) => v.replace(/&amp;/g, "&").replace(/&quot;/g, '"').replace(/&#39;/g, "'").replace(/&lt;/g, "<").replace(/&gt;/g, ">");
  const attr = (tag, n) => { const m = tag.match(new RegExp("\\s" + n + '="([^"]*)"')); return m ? dec(m[1]) : ""; };
  const tags = (name) => body.match(new RegExp("<" + name + "\\b[^>]*>", "g")) || [];

  // Stores the answer in fixtures/ (needs Developer mode for the JavaScript sandbox)
  const saveFixture = (file) => {
    if (bru.getEnvVar("saveFixtures") !== "true") return;
    try {
      const fs = require("fs"), path = require("path");
      const dir = path.join(bru.cwd(), "fixtures");
      fs.mkdirSync(dir, { recursive: true });
      fs.writeFileSync(path.join(dir, file), body);
    } catch (e) {
      console.log("Fixture not saved (switch the JavaScript sandbox to Developer mode): " + e.message);
    }
  };
  saveFixture("explore-20-favourite-albums-browse.xml");

  const albums = tags("item").filter((t) => attr(t, "type") === "album");
  const next = (body.match(/nextKey="([^"]*)"/) || [])[1] || "";
  console.log(albums.length + " albums, " + body.length + " bytes, " + (next ? "nextKey: " + dec(next) : "no further pages") + " (compare with fixtures/12-library-favourites.xml)");
}

tests {
  const body = String(res.getBody() || "");
  const dec = (v) => v.replace(/&amp;/g, "&").replace(/&quot;/g, '"').replace(/&#39;/g, "'").replace(/&lt;/g, "<").replace(/&gt;/g, ">");
  const attr = (tag, n) => { const m = tag.match(new RegExp("\\s" + n + '="([^"]*)"')); return m ? dec(m[1]) : ""; };
  const tags = (name) => body.match(new RegExp("<" + name + "\\b[^>]*>", "g")) || [];
  const albums = tags("item").filter((t) => attr(t, "type") === "album");
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));
  test("list of albums with browseKey, playURL, contextMenuKey", () => {
    expect(albums.length).to.be.above(0);
    expect(albums.every((t) => attr(t, "browseKey") && attr(t, "playURL") && attr(t, "contextMenuKey"))).to.equal(true);
  });
  test("every album is a favourite (context menu key with isFavourite=1)", () => expect(albums.every((t) => /[?&]isFavourite=1/.test(attr(t, "contextMenuKey")))).to.equal(true));
  test("context menus offer favourite-delete", () => expect(/type="favourite-delete"/.test(body)).to.equal(true));
}
