meta {
  name: V56 Upgrade message (update)
  type: http
  seq: 141
}

get {
  url: http://{{host}}:11000/update
  body: none
  auth: none
}

settings {
  encodeUrl: false
}

script:post-response {
  // Upgrade message of the player: "no message", or the message of the upgrade service (stage0) when a firmware upgrade is ready.
  // Not called: /update?<n> (presumably a long poll), /update?clear=1 (clears the message), POST /update (sets it).
  const body = String(res.getBody() || "");
  const saveFixture = (file) => {
    if (bru.getEnvVar("saveFixtures") !== "true") return;
    try {
      const fs = require("fs"), path = require("path");
      const dir = path.join(bru.cwd(), "fixtures");
      fs.mkdirSync(dir, { recursive: true });
      fs.writeFileSync(path.join(dir, file), body);
    } catch (e) {
      console.log("Fixture not saved (switch the JavaScript sandbox to Developer mode): " + e.message);
    }
  };
  saveFixture("verify-update.xml");
  console.log("HTTP " + res.getStatus() + "\n" + body.slice(0, 3000));
}

tests {
  const body = String(res.getBody() || "");
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));
  test("root element update", () => expect(/<update\b/.test(body)).to.equal(true));
}
