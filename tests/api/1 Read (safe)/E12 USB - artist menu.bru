meta {
  name: E12 USB - artist menu
  type: http
  seq: 38
}

get {
  url: http://{{host}}:11000/
  body: none
  auth: none
}

settings {
  encodeUrl: false
}

script:pre-request {
  // Like E10 for the artist of the first new USB album (skipped without a USB drive).
  const H = "http://" + bru.getEnvVar("host") + ":11000";

  const svc = bru.getVar("usbSvc"), art = bru.getVar("usbNewArt");
  if (!svc || !art) { bru.runner.skipRequest(); return; }
  const form = (v) => encodeURIComponent(v).replace(/[!'()*]/g, (c) => "%" + c.charCodeAt(0).toString(16).toUpperCase()).replace(/%20/g, "+");
  req.setUrl(H + "/Browse?withContextMenuItems=1&key=" + encodeURIComponent(svc + ":MG/LocalMusic-Artist?artist=" + form(art)));
}

script:post-response {
  const body = String(res.getBody() || "");
  const dec = (v) => v.replace(/&amp;/g, "&").replace(/&quot;/g, '"').replace(/&#39;/g, "'").replace(/&lt;/g, "<").replace(/&gt;/g, ">");
  const attr = (tag, n) => { const m = tag.match(new RegExp("\\s" + n + '="([^"]*)"')); return m ? dec(m[1]) : ""; };
  const tags = (name) => body.match(new RegExp("<" + name + "\\b[^>]*>", "g")) || [];
  const link = tags("item").find((t) => attr(t, "type") === "link" && /:Album\//.test(attr(t, "browseKey")));
  bru.setVar("usbArtistAlbumsKey", link ? attr(link, "browseKey") : "");
}

tests {
  const body = String(res.getBody() || "");
  const dec = (v) => v.replace(/&amp;/g, "&").replace(/&quot;/g, '"').replace(/&#39;/g, "'").replace(/&lt;/g, "<").replace(/&gt;/g, ">");
  const attr = (tag, n) => { const m = tag.match(new RegExp("\\s" + n + '="([^"]*)"')); return m ? dec(m[1]) : ""; };
  const tags = (name) => body.match(new RegExp("<" + name + "\\b[^>]*>", "g")) || [];
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));
  test("menu with an Albums link (key contains :Album/)", () => expect(tags("item").some((t) => attr(t, "type") === "link" && /:Album\//.test(attr(t, "browseKey")))).to.equal(true));
}
