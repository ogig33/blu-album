meta {
  name: V17 UI my playlists row (library)
  type: http
  seq: 56
}

get {
  url: http://{{host}}:11000/ui/myPlaylistsRow?service=LocalMusic
  body: none
  auth: none
}

settings {
  encodeUrl: false
}

script:post-response {
  // BluOS app screen (/ui/...): read only. The answer goes to the console and fixtures/.
  const body = String(res.getBody() || "");
  // Stores the answer in fixtures/ (needs Developer mode for the JavaScript sandbox)
  const saveFixture = (file) => {
    if (bru.getEnvVar("saveFixtures") !== "true") return;
    try {
      const fs = require("fs"), path = require("path");
      const dir = path.join(bru.cwd(), "fixtures");
      fs.mkdirSync(dir, { recursive: true });
      fs.writeFileSync(path.join(dir, file), body);
    } catch (e) {
      console.log("Fixture not saved (switch the JavaScript sandbox to Developer mode): " + e.message);
    }
  };
  saveFixture("verify-ui-myplaylistsrow.xml");
  console.log("HTTP " + res.getStatus() + "\n" + body.slice(0, 4000));
}

tests {
  const body = String(res.getBody() || "");
  // Without playlists the player answers with an empty body (HTTP 200 or 204)
  test("HTTP 200 or 204", () => expect([200, 204]).to.include(res.getStatus()));
  // Empty answer when the source has no playlists (no row on the home screen)
  test("no error", () => expect(/<error/i.test(body)).to.equal(false));
}
