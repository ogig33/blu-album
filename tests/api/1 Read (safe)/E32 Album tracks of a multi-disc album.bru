meta {
  name: E32 Album tracks of a multi-disc album
  type: http
  seq: 109
}

get {
  url: http://{{host}}:11000/
  body: none
  auth: none
}

settings {
  encodeUrl: false
}

script:pre-request {
  // Album popup with disc headers: how does /Browse list the tracks of an album with several discs?
  // Finds the first song with discno >= 2 in the library search, reads the songs of its album
  // (/library/v1/Songs, discno per song) and asks the album track list as the app does. Read only.
  const H = "http://" + bru.getEnvVar("host") + ":11000";
  const axios = require("axios");
  const get = async (p) => String((await axios.get(H + p, { responseType: "text", transformResponse: (x) => x, headers: { "Accept-Language": "en" } })).data || "");
  const dec = (v) => v.replace(/&amp;/g, "&").replace(/&quot;/g, '"').replace(/&#39;/g, "'").replace(/&lt;/g, "<").replace(/&gt;/g, ">");
  const pick = (s, t) => { const m = s.match(new RegExp("<" + t + ">([^<]*)</" + t + ">")); return m ? dec(m[1]) : ""; };
  let album = "", artist = "";
  for (const e of ["a", "e", "i", "o"]) {
    const s = await get("/library/v1/Search?service=LocalMusic&expr=" + e);
    const hit = [...s.matchAll(/<song>([\s\S]*?)<\/song>/g)].map((m) => m[1]).find((x) => +pick(x, "discno") >= 2);
    if (hit) { album = pick(hit, "alb"); artist = pick(hit, "albumartist") || pick(hit, "art"); break; }
  }
  if (!album) { console.log("No song with discno >= 2 found in the search"); bru.runner.skipRequest(); return; }
  const q = "album=" + encodeURIComponent(album) + "&artist=" + encodeURIComponent(artist);
  const songs = await get("/library/v1/Songs?service=LocalMusic&" + q);
  bru.setVar("eDiscSongs", JSON.stringify([...songs.matchAll(/<song\b[\s\S]*?<\/song>/g)].map((m) => ({ title: pick(m[0], "title"), track: +pick(m[0], "track"), disc: +pick(m[0], "discno") || 0 }))));
  bru.setVar("eDiscAlbum", album + " / " + artist);
  req.setUrl(H + "/Browse?withContextMenuItems=0&key=" + encodeURIComponent("LocalMusic:MG/LocalMusic-Album?" + q.replace(/%20/g, "+")));
}

script:post-response {
  const body = String(res.getBody() || "");
  // Stores the answer in fixtures/ (needs Developer mode for the JavaScript sandbox)
  const saveFixture = (file) => {
    if (bru.getEnvVar("saveFixtures") !== "true") return;
    try {
      const fs = require("fs"), path = require("path");
      const dir = path.join(bru.cwd(), "fixtures");
      fs.mkdirSync(dir, { recursive: true });
      fs.writeFileSync(path.join(dir, file), body);
    } catch (e) {
      console.log("Fixture not saved (switch the JavaScript sandbox to Developer mode): " + e.message);
    }
  };
  saveFixture("explore-32-multi-disc-album-tracks.xml");
  const songs = JSON.parse(bru.getVar("eDiscSongs") || "[]");
  const texts = [...body.matchAll(/<item\b[^>]*\stype="track"[^>]*>/g)].map((m) => ((m[0].match(/\stext="([^"]*)"/) || [])[1] || ""));
  console.log("album: " + bru.getVar("eDiscAlbum") + ", " + texts.length + " tracks, " + songs.length + " songs");
  texts.forEach((t, i) => console.log((songs[i] ? "disc " + songs[i].disc + " track " + songs[i].track : "-") + " | " + t));
}

tests {
  const body = String(res.getBody() || "");
  const dec = (v) => v.replace(/&amp;/g, "&").replace(/&quot;/g, '"').replace(/&#39;/g, "'").replace(/&lt;/g, "<").replace(/&gt;/g, ">");
  const songs = JSON.parse(bru.getVar("eDiscSongs") || "[]");
  const tracks = [...body.matchAll(/<item\b[^>]*\stype="track"[^>]*>/g)].map((m) => dec((m[0].match(/\stext="([^"]*)"/) || [])[1] || ""));
  const num = (t) => +((t.match(/^(\d+)\.\s/) || [])[1] || 0);
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));
  test("songs span several discs", () => expect(new Set(songs.map((s) => s.disc)).size).to.be.above(1));
  test("songs are sorted by disc and track", () => expect(songs.every((s, i) => !i || s.disc > songs[i - 1].disc || (s.disc === songs[i - 1].disc && s.track > songs[i - 1].track))).to.equal(true));
  test("one track per song", () => expect(tracks.length).to.equal(songs.length));
  // The disc of a track is the discno of the song at the same position. The track number does not
  // mark the disc: it starts again at 1 on most albums, but runs on across the discs when tagged so.
  test("tracks in the order of the songs: number and title match by position", () => expect(tracks.every((t, i) => num(t) === songs[i].track && t.replace(/^\d+\.\s*/, "") === songs[i].title)).to.equal(true));
}
