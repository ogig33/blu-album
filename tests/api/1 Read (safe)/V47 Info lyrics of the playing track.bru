meta {
  name: V47 Info lyrics of the playing track
  type: http
  seq: 94
}

get {
  url: http://{{host}}:11000/Info
  body: none
  auth: none
}

settings {
  encodeUrl: false
}

script:pre-request {
  const H = "http://" + bru.getEnvVar("host") + ":11000";
  const axios = require("axios");
  const st = String((await axios.get(H + "/Status", { responseType: "text", transformResponse: (x) => x })).data || "");
  const id = (st.match(/<lyricsid>([^<]*)<\/lyricsid>/) || [])[1], svc = (st.match(/<service>([^<]*)<\/service>/) || [])[1];
  if (!id) { console.log("No lyricsid in /Status – skipped (play Radio Paradise)"); bru.runner.skipRequest(); return; }
  req.setUrl(H + "/Info?lyricsid=" + encodeURIComponent(id) + "&service=" + encodeURIComponent(svc || ""));
}

script:post-response {
  // Lyrics of the playing track (/Info?lyricsid=…), only when /Status has a lyricsid (e.g. Radio Paradise): read only. The answer goes to the console and fixtures/.
  const body = String(res.getBody() || "");
  // Stores the answer in fixtures/ (needs Developer mode for the JavaScript sandbox)
  const saveFixture = (file) => {
    if (bru.getEnvVar("saveFixtures") !== "true") return;
    try {
      const fs = require("fs"), path = require("path");
      const dir = path.join(bru.cwd(), "fixtures");
      fs.mkdirSync(dir, { recursive: true });
      fs.writeFileSync(path.join(dir, file), body);
    } catch (e) {
      console.log("Fixture not saved (switch the JavaScript sandbox to Developer mode): " + e.message);
    }
  };
  saveFixture("verify-info-lyrics.xml");
  console.log(body.slice(0, 4000));
}

tests {
  const body = String(res.getBody() || "");
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));
  test("answer has a root element, no error", () => { expect(/<[A-Za-z]/.test(body)).to.equal(true); expect(/<error/i.test(body)).to.equal(false); });
}
