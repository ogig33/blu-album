meta {
  name: E34 Albums of a section with year (library)
  type: http
  seq: 111
}

get {
  url: http://{{host}}:11000/library/v1/Albums
  body: none
  auth: none
}

settings {
  encodeUrl: false
}

script:pre-request {
  // Candidate for a decade filter: /Browse album lists carry no year, the sectioned /library/v1/Albums
  // list (as for the quality chips, here without a filter) has date="<year>" on every album with a year tag.
  // Albums without a year tag have no date attribute. Read only.
  const svc = bru.getVar("libSvc");
  if (!svc) { bru.runner.skipRequest(); return; }
  req.setUrl("http://" + bru.getEnvVar("host") + ":11000/library/v1/Albums?service=" + encodeURIComponent(svc) + "&limit=500&section=A");
}

script:post-response {
  const body = String(res.getBody() || "");
  // Stores the answer in fixtures/ (needs Developer mode for the JavaScript sandbox)
  const saveFixture = (file) => {
    if (bru.getEnvVar("saveFixtures") !== "true") return;
    try {
      const fs = require("fs"), path = require("path");
      const dir = path.join(bru.cwd(), "fixtures");
      fs.mkdirSync(dir, { recursive: true });
      fs.writeFileSync(path.join(dir, file), body);
    } catch (e) {
      console.log("Fixture not saved (switch the JavaScript sandbox to Developer mode): " + e.message);
    }
  };
  saveFixture("explore-34-section-albums-with-year.xml");
  const albums = body.match(/<album\b[^>]*>/g) || [];
  const decades = {};
  let none = 0;
  albums.forEach((t) => {
    const y = (t.match(/\sdate="(\d{4})"/) || [])[1];
    if (!y) { none++; return; }
    const d = y.slice(0, 3) + "0s";
    decades[d] = (decades[d] || 0) + 1;
  });
  console.log("section A: " + albums.length + " albums, " + body.length + " bytes, without year: " + none + ", per decade: " + JSON.stringify(decades));
}

tests {
  const body = String(res.getBody() || "");
  const albums = body.match(/<album\b[^>]*>/g) || [];
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));
  test("sectioned answer with albums", () => {
    expect(/<sections\b/.test(body)).to.equal(true);
    expect(albums.length).to.be.above(0);
  });
  test("date (if present) is a four-digit year", () => {
    albums.forEach((t) => {
      const m = t.match(/\sdate="([^"]*)"/);
      if (m) expect(m[1]).to.match(/^\d{4}$/);
    });
  });
  test("most albums have a year", () => expect(albums.filter((t) => /\sdate="/.test(t)).length).to.be.above(albums.length / 2));
}
