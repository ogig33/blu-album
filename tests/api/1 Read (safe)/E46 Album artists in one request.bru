meta {
  name: E46 Album artists in one request
  type: http
  seq: 128
}

get {
  url: http://{{host}}:11000/library/v1/Artists
  body: none
  auth: none
}

settings {
  encodeUrl: false
}

script:pre-request {
  // /library/v1/Artists with section=all answers all album artists in one answer (not used by the app, see the
  // decision against an album artist search). Songs and Composers answer only the index with section=all, an
  // empty list without length. Read only.
  const svc = bru.getVar("libSvc");
  if (!svc) { bru.runner.skipRequest(); return; }
  const H = "http://" + bru.getEnvVar("host") + ":11000";
  const axios = require("axios");
  const get = async (p) => String((await axios.get(H + p, { responseType: "text", transformResponse: (x) => x, headers: { "Accept-Language": "en" } })).data || "");
  const dec = (v) => v.replace(/&#(\d+);/g, (m, n) => String.fromCodePoint(+n)).replace(/&quot;/g, '"').replace(/&lt;/g, "<").replace(/&gt;/g, ">").replace(/&amp;/g, "&");
  const list = (s, ep) => "/library/v1/" + ep + "?service=" + encodeURIComponent(s);
  const index = async (s, ep, q) => [...(await get(list(s, ep) + q + "&section=all&length=1")).matchAll(/<section name="([^"]*)"([^>]*)>/g)].map((m) => ({ name: dec(m[1]), n: +((m[2].match(/\slength="(\d+)"/) || [])[1] || 0) })).filter((x) => x.n);
  const arts = (x) => [...x.matchAll(/<art\b[^>]*>([^<]*)<\/art>/g)].map((m) => m[1]);
  const idx = await index(svc, "Artists", ""), per = [];
  for (const x of idx) per.push(...arts(await get(list(svc, "Artists") + "&section=" + encodeURIComponent(x.name))));
  const all = arts(await get(list(svc, "Artists") + "&section=all"));
  const other = {};
  for (const ep of ["Songs", "Composers"]) other[ep] = { counted: (await index(svc, ep, "")).reduce((n, x) => n + x.n, 0), listed: ((await get(list(svc, ep) + "&section=all")).match(/<(song|composer)\b/g) || []).length };
  bru.setVar("e46", JSON.stringify({ artists: all.length, same: JSON.stringify(all) === JSON.stringify(per), other }));
  req.setUrl(H + list(svc, "Artists") + "&section=all");
}

script:post-response {
  const body = String(res.getBody() || "");
  // Stores the answer in fixtures/ (needs Developer mode for the JavaScript sandbox)
  const saveFixture = (file) => {
    if (bru.getEnvVar("saveFixtures") !== "true") return;
    try {
      const fs = require("fs"), path = require("path");
      const dir = path.join(bru.cwd(), "fixtures");
      fs.mkdirSync(dir, { recursive: true });
      fs.writeFileSync(path.join(dir, file), body);
    } catch (e) {
      console.log("Fixture not saved (switch the JavaScript sandbox to Developer mode): " + e.message);
    }
  };
  saveFixture("explore-46-album-artists.xml");
  console.log(bru.getVar("e46"));
}

tests {
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));
  const r = JSON.parse(bru.getVar("e46"));
  test("same artists as the requests per section", () => { expect(r.artists).to.be.above(0); expect(r.same).to.equal(true); });
  test("Songs and Composers list nothing with section=all", () => Object.keys(r.other).forEach((ep) => expect(r.other[ep].listed, ep).to.equal(0)));
}
