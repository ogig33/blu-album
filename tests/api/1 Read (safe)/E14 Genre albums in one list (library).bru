meta {
  name: E14 Genre albums in one list (library)
  type: http
  seq: 40
}

get {
  url: http://{{host}}:11000/
  body: none
  auth: none
}

settings {
  encodeUrl: false
}

script:pre-request {
  // Candidate for the genre chip and a genre map for the album popup: the albums of a genre without
  // sections. Tried 2026-11-15 and answered empty: the browse key
  // <svc>:Album/%2Flibrary%2Fv1%2FAlbums%3Fgenre=…&service=<svc> (also with &offset=0) and
  // /library/v1/Albums?genre=… without section (with limit=500 or offset=0).
  // The BluOS app lists them with this exact request (capture 2026-11-14): /ui/browseGrouped with the
  // genre album list as url. It answers a letter index (offset, length), the total and one page.
  const H = "http://" + bru.getEnvVar("host") + ":11000";

  const svc = bru.getVar("libSvc"), gk = bru.getVar("genreKey") || "";
  const genre = (gk.match(/[?&]genre=([^&]*)/) || [])[1] || "";
  if (!svc || !genre) { bru.runner.skipRequest(); return; }
  bru.setVar("libGenre", genre);
  req.setUrl(H + "/ui/browseGrouped?browseIndex=2&menuGroupId=Genres&service=" + svc + "&title=Albums&type=Album&url=" + encodeURIComponent("/library/v1/Albums?genre=" + genre + "&service=" + svc));
}

script:post-response {
  const body = String(res.getBody() || "");

  // Stores the answer in fixtures/ (needs Developer mode for the JavaScript sandbox)
  const saveFixture = (file) => {
    if (bru.getEnvVar("saveFixtures") !== "true") return;
    try {
      const fs = require("fs"), path = require("path");
      const dir = path.join(bru.cwd(), "fixtures");
      fs.mkdirSync(dir, { recursive: true });
      fs.writeFileSync(path.join(dir, file), body);
    } catch (e) {
      console.log("Fixture not saved (switch the JavaScript sandbox to Developer mode): " + e.message);
    }
  };
  saveFixture("explore-14-genre-albums-grouped.xml");

  const list = (body.match(/<list\b[^>]*>/) || [""])[0];
  const entries = (body.match(/<item\b[^>]*\btitle="[^"]*"[^>]*>[\s\S]*?<\/item>/g) || []);
  console.log(decodeURIComponent(bru.getVar("libGenre").replace(/\+/g, " ")) + ": " + list + ", " + entries.length + " entries on this page, " + body.length + " bytes");
  console.log(entries[0] || "(no entry)");
}

tests {
  const body = String(res.getBody() || "");
  const list = (body.match(/<list\b[^>]*>/) || [""])[0];
  const entries = (body.match(/<item\b[^>]*\btitle="[^"]*"[^>]*>[\s\S]*?<\/item>/g) || []);
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));
  test("list with a total", () => expect(+((list.match(/\btotal="(\d+)"/) || [])[1] || 0)).to.be.above(0));
  test("entries with title (album) and subTitle (artist)", () => {
    expect(entries.length).to.be.above(0);
    expect(entries.every((e) => /\bsubTitle="[^"]+"/.test(e))).to.equal(true);
  });
}
