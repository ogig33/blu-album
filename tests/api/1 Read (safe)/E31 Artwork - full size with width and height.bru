meta {
  name: E31 Artwork - full size with width and height
  type: http
  seq: 108
}

get {
  url: http://{{host}}:11000/Artwork
  body: none
  auth: none
}

headers {
  Origin: null
}

settings {
  encodeUrl: false
}

script:pre-request {
  // The album popup and the full-screen view ask the cover with width and height 3000: the player
  // answers its stored image scaled to that size, but never larger than the original. Without them it
  // answers at most 600 px. Full-size covers need "Optimize Artwork" off and a rebuilt index; with it on
  // the stored cover has 600 px (see docs/bluos-api.md, /Artwork).
  const img = bru.getVar("albumImage");
  if (!img) { bru.runner.skipRequest(); return; }
  req.setUrl("http://" + bru.getEnvVar("host") + ":11000" + img + "&width=3000&height=3000&followRedirects=1");
}

script:post-response {
  // Bruno hands the body over as UTF-8 text and the player sends it chunked (no Content-Length), so the
  // pixel and byte size cannot be read here; check them with the saved response or curl. A cover file
  // larger than 600 KB gives the player's grey placeholder (494 x 494 px, 17829 bytes) instead of the cover.
  console.log("Cover with width/height 3000: " + res.getHeader("content-type"));
}

tests {
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));
  test("returns an image", () => expect(String(res.getHeader("content-type"))).to.match(/^image\//));
  test("allows fetch() from any origin", () => expect(String(res.getHeader("access-control-allow-origin"))).to.equal("*"));
}
