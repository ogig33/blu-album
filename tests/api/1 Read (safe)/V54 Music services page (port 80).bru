meta {
  name: V54 Music services page (port 80)
  type: http
  seq: 116
}

get {
  url: http://{{host}}:80/services?noheader=1&schemaVersion=36
  body: none
  auth: none
}

settings {
  encodeUrl: false
}

script:post-response {
  const raw = res.getBody();
  const body = typeof raw === "string" ? raw : JSON.stringify(raw, null, 2);
  // Stores the answer in fixtures/ (needs Developer mode for the JavaScript sandbox)
  const saveFixture = (file, text) => {
    if (bru.getEnvVar("saveFixtures") !== "true") return;
    try {
      const fs = require("fs"), path = require("path");
      const dir = path.join(bru.cwd(), "fixtures");
      fs.mkdirSync(dir, { recursive: true });
      fs.writeFileSync(path.join(dir, file), text === undefined ? body : text);
    } catch (e) {
      console.log("Fixture not saved (switch the JavaScript sandbox to Developer mode): " + e.message);
    }
  };
  saveFixture("verify-services-page.html");
  const links = (body.match(/href="\/(credentials|spotifyinfo)\?[^"]*"/g) || []).map((l) => l.slice(6, -1));
  console.log("HTTP " + res.getStatus() + ", " + links.length + " service links\n" + links.join("\n"));
  // The same path on port 11000 does not exist (/Services there is the XML self-description)
  const axios = require("axios");
  const r = await axios.get("http://" + bru.getEnvVar("host") + ":11000/services?noheader=1", { responseType: "text", transformResponse: (x) => x, validateStatus: () => true, timeout: 10000 });
  bru.setVar("vsServices11000", String(r.status));
}

tests {
  const raw = res.getBody();
  const body = typeof raw === "string" ? raw : JSON.stringify(raw, null, 2);
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));
  test("HTML page 'Configure Music Services'", () => expect(/<title>Configure Music Services<\/title>/.test(body)).to.equal(true));
  test("links to the sign-in pages of the services", () => expect(/href="\/credentials\?service=/.test(body)).to.equal(true));
  test("not on port 11000 (404)", () => expect(bru.getVar("vsServices11000")).to.equal("404"));
}
