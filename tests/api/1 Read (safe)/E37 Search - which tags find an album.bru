meta {
  name: E37 Search - which tags find an album
  type: http
  seq: 118
}

get {
  url: http://{{host}}:11000/Browse
  body: none
  auth: none
}

settings {
  encodeUrl: false
}

script:pre-request {
  // Which tags does the albums list of the player's search (/Browse searchKey + q, link "Albums") match?
  // Album of the first composer; one search each for a song title, a composer and a track artist of that album.
  // A term is only used when it does not occur in the album title, the album artist or any track artist of the album. Read only.
  const H = "http://" + bru.getEnvVar("host") + ":11000";
  const axios = require("axios");
  const get = async (p) => String((await axios.get(H + p, { responseType: "text", transformResponse: (x) => x, headers: { "Accept-Language": "en" } })).data || "");
  const dec = (v) => v.replace(/&amp;/g, "&").replace(/&quot;/g, '"').replace(/&#39;/g, "'").replace(/&lt;/g, "<").replace(/&gt;/g, ">");
  const pick = (x, t) => { const m = x.match(new RegExp("<" + t + ">([^<]*)</" + t + ">")); return m ? dec(m[1]) : ""; };
  const attr = (tag, n) => { const m = tag.match(new RegExp("\\s" + n + '="([^"]*)"')); return m ? dec(m[1]) : ""; };

  const c = await get("/library/v1/Composers?service=LocalMusic");
  const comp = dec((c.match(/<composer>([^<]+)<\/composer>/) || [])[1] || "");
  if (!comp) { bru.runner.skipRequest(); return; }
  const a = (await get("/library/v1/Albums?service=LocalMusic&composer=" + encodeURIComponent(comp))).match(/<album\b[^>]*>([\s\S]*?)<\/album>/);
  if (!a) { bru.runner.skipRequest(); return; }
  const album = pick(a[1], "title"), albumArtist = pick(a[1], "art");
  const songs = [...(await get("/library/v1/Songs?service=LocalMusic&album=" + encodeURIComponent(album) + "&artist=" + encodeURIComponent(albumArtist))).matchAll(/<song\b[\s\S]*?<\/song>/g)]
    .map((m) => ({ title: pick(m[0], "title"), art: pick(m[0], "art"), composer: pick(m[0], "composer") }));
  const low = (s) => s.toLowerCase();
  const albumTexts = [album, albumArtist, ...songs.map((s) => s.art)].map(low);
  const free = (t) => t.length >= 3 && !albumTexts.some((x) => x.includes(low(t)));
  const term = {
    title: (songs.find((s) => free(s.title)) || {}).title || "",
    composer: (songs.find((s) => s.composer && free(s.composer) && !songs.some((o) => low(o.title).includes(low(s.composer)))) || {}).composer || "",
    trackArtist: (songs.find((s) => s.art && !low(album).includes(low(s.art)) && !low(albumArtist).includes(low(s.art))) || {}).art || ""
  };

  // Albums of the search's "Albums" link (all sections), as the app reads them
  const albumsLink = async (q) => {
    const menu = await get("/Browse?key=" + encodeURIComponent("LocalMusic:Search") + "&q=" + encodeURIComponent(q));
    const link = (menu.match(/<item\b[^>]*>/g) || []).find((t) => attr(t, "text") === "Albums");
    return link ? attr(link, "browseKey") : "";
  };
  const albumsOf = async (key) => {
    const its = (await get("/Browse?key=" + encodeURIComponent(key))).match(/<item\b[^>]*>/g) || [];
    const secs = its.filter((t) => attr(t, "type") === "section" && attr(t, "text2") !== "0");
    if (!secs.length) return its.filter((t) => attr(t, "type") === "album").map((t) => attr(t, "text") + " / " + attr(t, "text2"));
    const out = [];
    for (const s of secs) out.push(...await albumsOf(attr(s, "browseKey")));
    return out;
  };
  const target = album + " / " + albumArtist;
  const found = {};
  for (const k of ["title", "composer"]) found[k] = term[k] ? (await albumsOf(await albumsLink(term[k]))).includes(target) : null;
  console.log("album: " + target + " | song title: " + term.title + " → " + found.title + " | composer: " + term.composer + " → " + found.composer + " | track artist: " + term.trackArtist);
  bru.setVar("eSearchTarget", target);
  bru.setVar("eSearchFound", JSON.stringify(found));
  if (!term.trackArtist) { bru.runner.skipRequest(); return; }
  const key = await albumsLink(term.trackArtist);
  if (!key) { bru.runner.skipRequest(); return; }
  req.setUrl(H + "/Browse?key=" + encodeURIComponent(key));
}

script:post-response {
  const body = String(res.getBody() || "");
  // Stores the answer in fixtures/ (needs Developer mode for the JavaScript sandbox)
  const saveFixture = (file) => {
    if (bru.getEnvVar("saveFixtures") !== "true") return;
    try {
      const fs = require("fs"), path = require("path");
      const dir = path.join(bru.cwd(), "fixtures");
      fs.mkdirSync(dir, { recursive: true });
      fs.writeFileSync(path.join(dir, file), body);
    } catch (e) {
      console.log("Fixture not saved (switch the JavaScript sandbox to Developer mode): " + e.message);
    }
  };
  saveFixture("explore-37-search-track-artist-albums.xml");
}

tests {
  const body = String(res.getBody() || "");
  const dec = (v) => v.replace(/&amp;/g, "&").replace(/&quot;/g, '"').replace(/&#39;/g, "'").replace(/&lt;/g, "<").replace(/&gt;/g, ">");
  const attr = (tag, n) => { const m = tag.match(new RegExp("\\s" + n + '="([^"]*)"')); return m ? dec(m[1]) : ""; };
  const albums = (body.match(/<item\b[^>]*>/g) || []).filter((t) => attr(t, "type") === "album").map((t) => attr(t, "text") + " / " + attr(t, "text2"));
  const found = JSON.parse(bru.getVar("eSearchFound") || "{}");
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));
  test("a track artist finds the album", () => expect(albums).to.include(bru.getVar("eSearchTarget")));
  test("a song title does not find the album", () => { if (found.title !== null) expect(found.title).to.equal(false); });
  test("a composer does not find the album", () => { if (found.composer !== null) expect(found.composer).to.equal(false); });
}
