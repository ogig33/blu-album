meta {
  name: E41 Decade index without ui (library)
  type: http
  seq: 123
}

get {
  url: http://{{host}}:11000/library/v1/Albums
  body: none
  auth: none
}

settings {
  encodeUrl: false
}

script:pre-request {
  // Decade index of the decade chips: section=all&length=1 answers only the sections with their album counts
  // (no albums), with sort=decade one section per decade. It must count the same as the years (date) of the
  // A-Z sections, which the app reads when a decade is clicked; albums without a year are in no decade. Read only.
  const svc = bru.getVar("libSvc");
  if (!svc) { bru.runner.skipRequest(); return; }
  const base = "http://" + bru.getEnvVar("host") + ":11000/library/v1/Albums?service=" + encodeURIComponent(svc);
  const axios = require("axios");
  const get = async (q) => String((await axios.get(base + q, { responseType: "text", transformResponse: (x) => x, headers: { "Accept-Language": "en" } })).data || "");
  const dec = (v) => v.replace(/&quot;/g, '"').replace(/&#39;/g, "'").replace(/&amp;/g, "&");
  const sections = [...(await get("&section=all&length=1")).matchAll(/<section name="([^"]*)" length="(\d+)"/g)];
  const counts = {};
  for (const s of sections) {
    for (const m of (await get("&limit=500&section=" + encodeURIComponent(dec(s[1])))).matchAll(/<album\b[^>]*\sdate="(\d{4})"/g)) {
      const d = m[1].slice(0, 3) + "0";
      counts[d] = (counts[d] || 0) + 1;
    }
  }
  bru.setVar("e41Years", JSON.stringify(Object.keys(counts).sort().map((d) => [d, counts[d]])));
  req.setUrl(base + "&section=all&length=1&sort=decade");
}

script:post-response {
  const body = String(res.getBody() || "");
  // Stores the answer in fixtures/ (needs Developer mode for the JavaScript sandbox)
  const saveFixture = (file) => {
    if (bru.getEnvVar("saveFixtures") !== "true") return;
    try {
      const fs = require("fs"), path = require("path");
      const dir = path.join(bru.cwd(), "fixtures");
      fs.mkdirSync(dir, { recursive: true });
      fs.writeFileSync(path.join(dir, file), body);
    } catch (e) {
      console.log("Fixture not saved (switch the JavaScript sandbox to Developer mode): " + e.message);
    }
  };
  saveFixture("explore-41-decade-index-library.xml");
  console.log(body.length + " bytes: " + [...body.matchAll(/<section name="([^"]*)" length="(\d+)"/g)].map((m) => m[1] + "s " + m[2]).join(", "));
}

tests {
  const body = String(res.getBody() || "");
  const idx = [...body.matchAll(/<section name="([^"]*)" length="(\d+)"/g)].map((m) => [m[1], +m[2]]);
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));
  test("only the index, no albums", () => {
    expect(/<albums\b/.test(body)).to.equal(true);
    expect(/<album[\s>]/.test(body)).to.equal(false);
  });
  test("section names are decades (four digits ending in 0)", () => idx.forEach((i) => expect(i[0]).to.match(/^\d{3}0$/)));
  test("decades and counts = the years of the A-Z sections", () => expect(idx).to.deep.equal(JSON.parse(bru.getVar("e41Years"))));
}
