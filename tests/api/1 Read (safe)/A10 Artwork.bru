meta {
  name: A10 Artwork
  type: http
  seq: 10
}

get {
  url: http://{{host}}:11000/Artwork
  body: none
  auth: none
}

settings {
  encodeUrl: false
}

script:pre-request {
  const img = bru.getVar("albumImage");
  if (!img) { bru.runner.skipRequest(); return; }
  req.setUrl("http://" + bru.getEnvVar("host") + ":11000" + img + "&followRedirects=1");
}

script:post-response {
  const body = String(res.getBody() || "");
  const dec = (v) => v.replace(/&amp;/g, "&").replace(/&quot;/g, '"').replace(/&#39;/g, "'").replace(/&lt;/g, "<").replace(/&gt;/g, ">");
  const attr = (tag, n) => { const m = tag.match(new RegExp("\\s" + n + '="([^"]*)"')); return m ? dec(m[1]) : ""; };
  const tags = (name) => body.match(new RegExp("<" + name + "\\b[^>]*>", "g")) || [];
  const items = (type) => tags("item").filter((t) => !type || attr(t, "type") === type);
}

tests {
  const body = String(res.getBody() || "");
  const dec = (v) => v.replace(/&amp;/g, "&").replace(/&quot;/g, '"').replace(/&#39;/g, "'").replace(/&lt;/g, "<").replace(/&gt;/g, ">");
  const attr = (tag, n) => { const m = tag.match(new RegExp("\\s" + n + '="([^"]*)"')); return m ? dec(m[1]) : ""; };
  const tags = (name) => body.match(new RegExp("<" + name + "\\b[^>]*>", "g")) || [];
  const items = (type) => tags("item").filter((t) => !type || attr(t, "type") === type);
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));

  test("returns an image", () => expect(String(res.getHeader("content-type"))).to.match(/^image\//));
}
