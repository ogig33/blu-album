meta {
  name: E17 Albums of a favourite's artist
  type: http
  seq: 43
}

get {
  url: http://{{host}}:11000/
  body: none
  auth: none
}

settings {
  encodeUrl: false
}

script:pre-request {
  // The app's artist view (E10 / E11) for the artist of the first favourite (A12).
  // Verified 2026-11-15: the artist list does NOT mark favourites – no isFavourite, no
  // &isFavourite=1 in the contextMenuKey, and the context menu offers favourite-add.
  // The tests check this known behaviour, so a firmware that changes it shows up here.
  const H = "http://" + bru.getEnvVar("host") + ":11000";

  const svc = bru.getVar("libSvc"), art = bru.getVar("favArtist") || "";
  if (!svc || !art) { bru.runner.skipRequest(); return; }
  const form = (v) => encodeURIComponent(v).replace(/[!'()*]/g, (c) => "%" + c.charCodeAt(0).toString(16).toUpperCase()).replace(/%20/g, "+");
  req.setUrl(H + "/Browse?withContextMenuItems=1&key=" + encodeURIComponent(svc + ":Album/%2Flibrary%2Fv1%2FAlbums%3Fartist=" + form(art) + "&service=" + svc));
}

script:post-response {
  const body = String(res.getBody() || "");

  // Stores the answer in fixtures/ (needs Developer mode for the JavaScript sandbox)
  const saveFixture = (file) => {
    if (bru.getEnvVar("saveFixtures") !== "true") return;
    try {
      const fs = require("fs"), path = require("path");
      const dir = path.join(bru.cwd(), "fixtures");
      fs.mkdirSync(dir, { recursive: true });
      fs.writeFileSync(path.join(dir, file), body);
    } catch (e) {
      console.log("Fixture not saved (switch the JavaScript sandbox to Developer mode): " + e.message);
    }
  };
  saveFixture("explore-17-favourite-artist-albums.xml");
  console.log(bru.getVar("favArtist") + " / " + bru.getVar("favAlbum") + ": " + body.length + " bytes");
}

tests {
  const body = String(res.getBody() || "");
  const dec = (v) => v.replace(/&amp;/g, "&").replace(/&quot;/g, '"').replace(/&#39;/g, "'").replace(/&lt;/g, "<").replace(/&gt;/g, ">");
  const attr = (tag, n) => { const m = tag.match(new RegExp("\\s" + n + '="([^"]*)"')); return m ? dec(m[1]) : ""; };
  const blocks = body.match(/<item\b[^>]*type="album"[^>]*>[\s\S]*?<\/item>\s*(?=<item\b[^>]*type="album"|<\/browse>)/g) || [];
  const fav = blocks.find((b) => attr(b.match(/<item\b[^>]*>/)[0], "text") === bru.getVar("favAlbum"));
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));
  test("list contains the favourite album", () => expect(!!fav).to.equal(true));
  test("known: favourite album is not marked (no isFavourite=1 in the contextMenuKey)", () => expect(/[?&]isFavourite=1/.test(attr(fav.match(/<item\b[^>]*>/)[0], "contextMenuKey"))).to.equal(false));
  test("known: favourite album offers favourite-add instead of favourite-delete", () => expect(/type="favourite-add"/.test(fav) && !/type="favourite-delete"/.test(fav)).to.equal(true));
}
