meta {
  name: E45 MQA songs without MQA albums
  type: http
  seq: 127
}

get {
  url: http://{{host}}:11000/library/v1/Albums
  body: none
  auth: none
}

settings {
  encodeUrl: false
}

script:pre-request {
  // Player bug: albums whose songs all have quality mqaBrowse are in no quality list of /library/v1/Albums
  // (hr, cd, mqa, mqaBrowse), although the songs filter quality=mqa finds the songs. Skipped without such songs.
  // When this fails after a firmware update, the bug may be fixed. Files checked 2026-11-22: real MQA. Read only.
  const svc = bru.getVar("libSvc");
  if (!svc) { bru.runner.skipRequest(); return; }
  const H = "http://" + bru.getEnvVar("host") + ":11000";
  const axios = require("axios");
  const get = async (p) => String((await axios.get(H + p, { responseType: "text", transformResponse: (x) => x, headers: { "Accept-Language": "en" } })).data || "");
  const dec = (v) => v.replace(/&#(\d+);/g, (m, n) => String.fromCodePoint(+n)).replace(/&quot;/g, '"').replace(/&lt;/g, "<").replace(/&gt;/g, ">").replace(/&amp;/g, "&");
  const list = (s, ep) => "/library/v1/" + ep + "?service=" + encodeURIComponent(s);
  const index = async (s, ep, q) => [...(await get(list(s, ep) + q + "&section=all&length=1")).matchAll(/<section name="([^"]*)"([^>]*)>/g)].map((m) => ({ name: dec(m[1]), n: +((m[2].match(/\slength="(\d+)"/) || [])[1] || 0) })).filter((x) => x.n);
  const secs = await index(svc, "Songs", "&quality=mqa"), songs = secs.reduce((n, x) => n + x.n, 0);
  if (!songs) { bru.runner.skipRequest(); return; }
  const first = secs[0];
  const song = (await get(list(svc, "Songs") + "&quality=mqa&section=" + encodeURIComponent(first.name))).match(/<alb>([^<]*)<\/alb>/);
  const album = song ? dec(song[1]) : "", found = [];
  for (const q of ["hr", "cd", "mqa", "mqaBrowse"]) {
    for (const m of (await get(list(svc, "Albums") + "&quality=" + q + "&section=all")).matchAll(/<title>([^<]*)<\/title>/g)) if (dec(m[1]) === album) found.push(q);
  }
  bru.setVar("e45", JSON.stringify({ songs, album, found }));
  req.setUrl(H + list(svc, "Albums") + "&quality=mqa&section=all");
}

script:post-response {
  const body = String(res.getBody() || "");
  // Stores the answer in fixtures/ (needs Developer mode for the JavaScript sandbox)
  const saveFixture = (file) => {
    if (bru.getEnvVar("saveFixtures") !== "true") return;
    try {
      const fs = require("fs"), path = require("path");
      const dir = path.join(bru.cwd(), "fixtures");
      fs.mkdirSync(dir, { recursive: true });
      fs.writeFileSync(path.join(dir, file), body);
    } catch (e) {
      console.log("Fixture not saved (switch the JavaScript sandbox to Developer mode): " + e.message);
    }
  };
  saveFixture("explore-45-quality-mqa.xml");
  console.log(bru.getVar("e45"));
}

tests {
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));
  const r = JSON.parse(bru.getVar("e45"));
  test("a song of the MQA songs filter", () => expect(r.album).to.not.equal(""));
  test("its album is in no quality list (player bug)", () => expect(r.found).to.deep.equal([]));
}
