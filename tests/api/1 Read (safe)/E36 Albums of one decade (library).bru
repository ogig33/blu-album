meta {
  name: E36 Albums of one decade (library)
  type: http
  seq: 113
}

get {
  url: http://{{host}}:11000/ui/browseGrouped
  body: none
  auth: none
}

settings {
  encodeUrl: false
}

script:pre-request {
  // Jumps straight to the last decade of E35 with listContinuation=<offset of the decade>: a decade can be
  // loaded without the pages before it. The page size stays 30 (limit / count in either place are ignored).
  // Read only.
  const svc = bru.getVar("libSvc"), offset = bru.getVar("decadeOffset");
  if (!svc || !offset) { bru.runner.skipRequest(); return; }
  req.setUrl("http://" + bru.getEnvVar("host") + ":11000/ui/browseGrouped?browseIndex=1&listContinuation=" + offset + "&menuGroupId=" + svc + "&service=" + svc + "&title=Albums&type=Album&url=" + encodeURIComponent("/library/v1/Albums?service=" + svc + "&sort=decade"));
}

script:post-response {
  const body = String(res.getBody() || "");
  // Stores the answer in fixtures/ (needs Developer mode for the JavaScript sandbox)
  const saveFixture = (file) => {
    if (bru.getEnvVar("saveFixtures") !== "true") return;
    try {
      const fs = require("fs"), path = require("path");
      const dir = path.join(bru.cwd(), "fixtures");
      fs.mkdirSync(dir, { recursive: true });
      fs.writeFileSync(path.join(dir, file), body);
    } catch (e) {
      console.log("Fixture not saved (switch the JavaScript sandbox to Developer mode): " + e.message);
    }
  };
  saveFixture("explore-36-albums-of-one-decade.xml");
  const entries = [...body.matchAll(/<item\b[^>]*\btitle="([^"]*)" subTitle="([^"]*)"/g)].map((m) => m[1] + " / " + m[2]);
  console.log(bru.getVar("decadeKey") + "s: " + (body.match(/<list\b[^>]*>/) || [""])[0] + "\n" + entries.join("\n"));
}

tests {
  const body = String(res.getBody() || "");
  const entries = body.match(/<item\b[^>]*\btitle="[^"]*"[^>]*>[\s\S]*?<\/item>/g) || [];
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));
  test("list starts at the offset of the decade", () => expect((body.match(/<list\b[^>]*\boffset="(\d+)"/) || [])[1]).to.equal(bru.getVar("decadeOffset")));
  test("1 to 30 entries with album and artist", () => {
    expect(entries.length).to.be.above(0);
    expect(entries.length).to.be.at.most(30);
    entries.forEach((e) => expect(e).to.match(/\bsubTitle="[^"]+"/));
  });
}
