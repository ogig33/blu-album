meta {
  name: S06 Audio settings (remember values)
  type: http
  seq: 6
}

get {
  url: http://{{host}}:11000/Settings?schemaVersion=36&id=audio
  body: none
  auth: none
}

settings {
  encodeUrl: false
}

script:post-response {
  const body = String(res.getBody() || "");
  const dec = (v) => v.replace(/&amp;/g, "&").replace(/&quot;/g, '"').replace(/&#39;/g, "'").replace(/&lt;/g, "<").replace(/&gt;/g, ">");
  const attr = (tag, n) => { const m = tag.match(new RegExp("\\s" + n + '="([^"]*)"')); return m ? dec(m[1]) : ""; };
  const tags = (name) => body.match(new RegExp("<" + name + "\\b[^>]*>", "g")) || [];
  const val = (tag) => { const m = body.match(new RegExp("<" + tag + ">([^<]*)</" + tag + ">")); return m ? dec(m[1]) : ""; };
  const setting = (name) => tags("setting").find((t) => attr(t, "name") === name) || "";
  console.log("HTTP " + res.getStatus() + "\n" + body.slice(0, 3000));
  const rg = attr(setting("replayGainMode"), "value"), bal = attr(setting("eq-balance"), "value");
  bru.setVar("vsRg", rg); bru.setVar("vsRgNew", rg === "album" ? "track" : "album");
  bru.setVar("vsBal", bal); bru.setVar("vsBalNew", parseFloat(bal) === 0 ? "0.5" : "0");
  const trim = tags("setting").find((t) => /\/SlaveVolume\?/.test(attr(t, "url"))) || "";
  bru.setVar("vsTrimUrl", attr(trim, "url"));
  bru.setVar("vsTrim", attr(trim, "value"));
  bru.setVar("vsTrimNew", parseFloat(attr(trim, "value") || "0") === 0 ? "1" : "0");
  bru.setVar("vsTrimId", attr(trim, "id"));
}

tests {
  const body = String(res.getBody() || "");
  const dec = (v) => v.replace(/&amp;/g, "&").replace(/&quot;/g, '"').replace(/&#39;/g, "'").replace(/&lt;/g, "<").replace(/&gt;/g, ">");
  const attr = (tag, n) => { const m = tag.match(new RegExp("\\s" + n + '="([^"]*)"')); return m ? dec(m[1]) : ""; };
  const tags = (name) => body.match(new RegExp("<" + name + "\\b[^>]*>", "g")) || [];
  const val = (tag) => { const m = body.match(new RegExp("<" + tag + ">([^<]*)</" + tag + ">")); return m ? dec(m[1]) : ""; };
  const setting = (name) => tags("setting").find((t) => attr(t, "name") === name) || "";
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));
  test("has replayGainMode and eq-balance", () => { expect(attr(setting("replayGainMode"), "value")).to.not.equal(""); expect(attr(setting("eq-balance"), "value")).to.not.equal(""); });
}
