meta {
  name: S04 setting ledbrightness (restore)
  type: http
  seq: 4
}

get {
  url: http://{{host}}:11000/setting
  body: none
  auth: none
}

settings {
  encodeUrl: false
}

script:pre-request {
  const H = "http://" + bru.getEnvVar("host") + ":11000";
  const H80 = "http://" + bru.getEnvVar("host") + ":80";
  if (!bru.getVar("vsLed")) { bru.runner.skipRequest(); return; }
  req.setUrl(H + "/setting?ledbrightness=" + bru.getVar("vsLed"));
}

script:post-response {
  const body = String(res.getBody() || "");
  const dec = (v) => v.replace(/&amp;/g, "&").replace(/&quot;/g, '"').replace(/&#39;/g, "'").replace(/&lt;/g, "<").replace(/&gt;/g, ">");
  const attr = (tag, n) => { const m = tag.match(new RegExp("\\s" + n + '="([^"]*)"')); return m ? dec(m[1]) : ""; };
  const tags = (name) => body.match(new RegExp("<" + name + "\\b[^>]*>", "g")) || [];
  const val = (tag) => { const m = body.match(new RegExp("<" + tag + ">([^<]*)</" + tag + ">")); return m ? dec(m[1]) : ""; };
  const setting = (name) => tags("setting").find((t) => attr(t, "name") === name) || "";
  console.log("HTTP " + res.getStatus() + "\n" + body.slice(0, 3000));

}

tests {
  const body = String(res.getBody() || "");
  const dec = (v) => v.replace(/&amp;/g, "&").replace(/&quot;/g, '"').replace(/&#39;/g, "'").replace(/&lt;/g, "<").replace(/&gt;/g, ">");
  const attr = (tag, n) => { const m = tag.match(new RegExp("\\s" + n + '="([^"]*)"')); return m ? dec(m[1]) : ""; };
  const tags = (name) => body.match(new RegExp("<" + name + "\\b[^>]*>", "g")) || [];
  const val = (tag) => { const m = body.match(new RegExp("<" + tag + ">([^<]*)</" + tag + ">")); return m ? dec(m[1]) : ""; };
  const setting = (name) => tags("setting").find((t) => attr(t, "name") === name) || "";
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));
  test("no error", () => expect(/<error/i.test(body)).to.equal(false));
}
