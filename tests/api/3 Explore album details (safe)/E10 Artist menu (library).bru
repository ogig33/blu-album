meta {
  name: E10 Artist menu (library)
  type: http
  seq: 10
}

get {
  url: http://{{host}}:11000/
  body: none
  auth: none
}

settings {
  encodeUrl: false
}

script:pre-request {
  // Artist click in the app: the artist's browse menu (key <svc>:MG/LocalMusic-Artist?artist=...)
  // links to the albums of the artist (E11), with the player's play URLs and context menus.
  const H = "http://" + bru.getEnvVar("host") + ":11000";

  const key = bru.getVar("albumKey") || "";
  if (!key) { bru.runner.skipRequest(); return; }
  const svc = key.split(":")[0], artist = (key.match(/[?&]artist=([^&]*)/) || [])[1] || "";
  req.setUrl(H + "/Browse?withContextMenuItems=1&key=" + encodeURIComponent(svc + ":MG/LocalMusic-Artist?artist=" + artist));
}

script:post-response {
  const body = String(res.getBody() || "");
  const dec = (v) => v.replace(/&amp;/g, "&").replace(/&quot;/g, '"').replace(/&#39;/g, "'").replace(/&lt;/g, "<").replace(/&gt;/g, ">");
  const attr = (tag, n) => { const m = tag.match(new RegExp("\\s" + n + '="([^"]*)"')); return m ? dec(m[1]) : ""; };
  const tags = (name) => body.match(new RegExp("<" + name + "\\b[^>]*>", "g")) || [];
  const link = tags("item").find((t) => attr(t, "type") === "link" && /:Album\//.test(attr(t, "browseKey")));
  bru.setVar("artistAlbumsKey", link ? attr(link, "browseKey") : "");
  console.log(body);
}

tests {
  const body = String(res.getBody() || "");
  const dec = (v) => v.replace(/&amp;/g, "&").replace(/&quot;/g, '"').replace(/&#39;/g, "'").replace(/&lt;/g, "<").replace(/&gt;/g, ">");
  const attr = (tag, n) => { const m = tag.match(new RegExp("\\s" + n + '="([^"]*)"')); return m ? dec(m[1]) : ""; };
  const tags = (name) => body.match(new RegExp("<" + name + "\\b[^>]*>", "g")) || [];
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));
  test("menu with an Albums link (key contains :Album/)", () => expect(tags("item").some((t) => attr(t, "type") === "link" && /:Album\//.test(attr(t, "browseKey")))).to.equal(true));
}
