meta {
  name: E11 Albums of the artist (library)
  type: http
  seq: 11
}

get {
  url: http://{{host}}:11000/
  body: none
  auth: none
}

settings {
  encodeUrl: false
}

script:pre-request {
  // Follows the Albums link of the artist menu (E10): all albums of the artist in one list.
  const H = "http://" + bru.getEnvVar("host") + ":11000";

  const key = bru.getVar("artistAlbumsKey") || "";
  if (!key) { bru.runner.skipRequest(); return; }
  req.setUrl(H + "/Browse?withContextMenuItems=1&key=" + encodeURIComponent(key));
}

script:post-response {
  const body = String(res.getBody() || "");
  // Stores the answer in fixtures/ (needs Developer mode for the JavaScript sandbox)
  const saveFixture = (file) => {
    if (bru.getEnvVar("saveFixtures") !== "true") return;
    try {
      const fs = require("fs"), path = require("path");
      const dir = path.join(bru.cwd(), "fixtures");
      fs.mkdirSync(dir, { recursive: true });
      fs.writeFileSync(path.join(dir, file), body);
    } catch (e) {
      console.log("Fixture not saved (switch the JavaScript sandbox to Developer mode): " + e.message);
    }
  };
  saveFixture("explore-11-artist-albums.xml");
  console.log(body.length + " bytes");
}

tests {
  const body = String(res.getBody() || "");
  const dec = (v) => v.replace(/&amp;/g, "&").replace(/&quot;/g, '"').replace(/&#39;/g, "'").replace(/&lt;/g, "<").replace(/&gt;/g, ">");
  const attr = (tag, n) => { const m = tag.match(new RegExp("\\s" + n + '="([^"]*)"')); return m ? dec(m[1]) : ""; };
  const tags = (name) => body.match(new RegExp("<" + name + "\\b[^>]*>", "g")) || [];
  const albums = tags("item").filter((t) => attr(t, "type") === "album");
  const album = (bru.getVar("albumKey").match(/[?&]album=([^&]*)/) || [])[1] || "";
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));
  test("list of albums, no further pages", () => {
    expect(albums.length).to.be.above(0);
    expect(/nextKey=/.test(body)).to.equal(false);
  });
  test("albums have browseKey, playURL, contextMenuKey, image", () => expect(albums.every((t) => attr(t, "browseKey") && attr(t, "playURL") && attr(t, "contextMenuKey") && attr(t, "image"))).to.equal(true));
  test("context menus with add-last action", () => expect(/type="addAll-last"/.test(body)).to.equal(true));
  test("contains the album the artist came from", () => expect(albums.some((t) => attr(t, "browseKey").includes("album=" + album + "&"))).to.equal(true));
}
