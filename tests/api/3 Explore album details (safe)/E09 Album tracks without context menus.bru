meta {
  name: E09 Album tracks without context menus
  type: http
  seq: 9
}

get {
  url: http://{{host}}:11000/
  body: none
  auth: none
}

settings {
  encodeUrl: false
}

script:pre-request {
  // Album popup: the track list is read without the per-song context menus (not used by the app,
  // about 60 % of the answer). Play URLs and durations must still be there.
  const H = "http://" + bru.getEnvVar("host") + ":11000";

  const key = bru.getVar("albumKey") || "";
  if (!key) { bru.runner.skipRequest(); return; }

  req.setUrl(H + "/Browse?withContextMenuItems=0&key=" + encodeURIComponent(key));
}

script:post-response {
  const body = String(res.getBody() || "");

  // Stores the answer in fixtures/ (needs Developer mode for the JavaScript sandbox)
  const saveFixture = (file) => {
    if (bru.getEnvVar("saveFixtures") !== "true") return;
    try {
      const fs = require("fs"), path = require("path");
      const dir = path.join(bru.cwd(), "fixtures");
      fs.mkdirSync(dir, { recursive: true });
      fs.writeFileSync(path.join(dir, file), body);
    } catch (e) {
      console.log("Fixture not saved (switch the JavaScript sandbox to Developer mode): " + e.message);
    }
  };
  saveFixture("explore-09-album-tracks-no-cm.xml");
  console.log(body.length + " bytes");
}

tests {
  const body = String(res.getBody() || "");
  const dec = (v) => v.replace(/&amp;/g, "&").replace(/&quot;/g, '"').replace(/&#39;/g, "'").replace(/&lt;/g, "<").replace(/&gt;/g, ">");
  const attr = (tag, n) => { const m = tag.match(new RegExp("\\s" + n + '="([^"]*)"')); return m ? dec(m[1]) : ""; };
  const tags = (name) => body.match(new RegExp("<" + name + "\\b[^>]*>", "g")) || [];
  const tracks = tags("item").filter((t) => attr(t, "type") === "track");
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));
  test("album has tracks", () => expect(tracks.length).to.be.above(0));
  test("tracks have text, duration and a play URL", () => expect(tracks.every((t) => attr(t, "text") && attr(t, "duration") && (attr(t, "autoplayURL") || attr(t, "playURL")))).to.equal(true));
  test("no context menus", () => expect(/<contextMenu\b/.test(body)).to.equal(false));
}
