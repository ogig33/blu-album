meta {
  name: E13 USB - albums of the artist
  type: http
  seq: 13
}

get {
  url: http://{{host}}:11000/
  body: none
  auth: none
}

settings {
  encodeUrl: false
}

script:pre-request {
  // Follows the Albums link of the USB artist menu (E12).
  const H = "http://" + bru.getEnvVar("host") + ":11000";

  const key = bru.getVar("usbArtistAlbumsKey") || "";
  if (!key) { bru.runner.skipRequest(); return; }
  req.setUrl(H + "/Browse?withContextMenuItems=1&key=" + encodeURIComponent(key));
}

tests {
  const body = String(res.getBody() || "");
  const dec = (v) => v.replace(/&amp;/g, "&").replace(/&quot;/g, '"').replace(/&#39;/g, "'").replace(/&lt;/g, "<").replace(/&gt;/g, ">");
  const attr = (tag, n) => { const m = tag.match(new RegExp("\\s" + n + '="([^"]*)"')); return m ? dec(m[1]) : ""; };
  const tags = (name) => body.match(new RegExp("<" + name + "\\b[^>]*>", "g")) || [];
  const albums = tags("item").filter((t) => attr(t, "type") === "album");
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));
  test("list of albums with playURL", () => {
    expect(albums.length).to.be.above(0);
    expect(albums.every((t) => attr(t, "playURL") && attr(t, "browseKey"))).to.equal(true);
  });
  test("no favourite actions on USB", () => expect(/favourite-(add|delete)/.test(body)).to.equal(false));
}
