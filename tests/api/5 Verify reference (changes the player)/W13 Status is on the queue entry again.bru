meta {
  name: W13 Status is on the queue entry again
  type: http
  seq: 13
}

get {
  url: http://{{host}}:11000/Status
  body: none
  auth: none
}

settings {
  encodeUrl: false
}

script:pre-request {
  const H = "http://" + bru.getEnvVar("host") + ":11000";
  await new Promise((r) => setTimeout(r, 2000)); // give the player time to change state
}

script:post-response {
  const body = String(res.getBody() || "");
  const dec = (v) => v.replace(/&amp;/g, "&").replace(/&quot;/g, '"').replace(/&#39;/g, "'").replace(/&lt;/g, "<").replace(/&gt;/g, ">");
  const attr = (tag, n) => { const m = tag.match(new RegExp("\\s" + n + '="([^"]*)"')); return m ? dec(m[1]) : ""; };
  const tags = (name) => body.match(new RegExp("<" + name + "\\b[^>]*>", "g")) || [];
  const val = (tag) => { const m = body.match(new RegExp("<" + tag + ">([^<]*)</" + tag + ">")); return m ? dec(m[1]) : ""; };
  console.log(body);

}

tests {
  const body = String(res.getBody() || "");
  const dec = (v) => v.replace(/&amp;/g, "&").replace(/&quot;/g, '"').replace(/&#39;/g, "'").replace(/&lt;/g, "<").replace(/&gt;/g, ">");
  const attr = (tag, n) => { const m = tag.match(new RegExp("\\s" + n + '="([^"]*)"')); return m ? dec(m[1]) : ""; };
  const tags = (name) => body.match(new RegExp("<" + name + "\\b[^>]*>", "g")) || [];
  const val = (tag) => { const m = body.match(new RegExp("<" + tag + ">([^<]*)</" + tag + ">")); return m ? dec(m[1]) : ""; };
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));
  test("same queue position as before", () => expect(val("song")).to.equal(bru.getVar("vrSong")));
  test("plays from the queue again (no streamUrl)", () => expect(/<streamUrl>/.test(body)).to.equal(false));
}
