meta {
  name: M40 Library id compared
  type: http
  seq: 40
}

get {
  url: http://{{host}}:11000/library/v1/Albums?service=LocalMusic&section=all&length=1
  body: none
  auth: none
}

settings {
  encodeUrl: false
}

script:pre-request {
  // Manual requests run only with the environment variable runManual = true
  if (bru.getEnvVar("runManual") !== "true") { bru.runner.skipRequest(); return; }
  // Reads the library id, the album count and the newest album again and logs what changed since M39
  // (bru variable, else fixtures/verify-library-id.json). Send it after each change, e.g. a favourite, a reindex, a new
  // album on the share. Read only; needs Developer mode (axios).
  const axios = require("axios");
  const L = "http://" + bru.getEnvVar("host") + ":11000/library/v1/Albums?service=LocalMusic";
  const get = async (q) => String((await axios.get(L + q, { responseType: "text", transformResponse: (x) => x, headers: { "Accept-Language": "en" } })).data || "");
  let before = bru.getVar("libSnap");
  if (!before) {
    try {
      before = require("fs").readFileSync(require("path").join(bru.cwd(), "fixtures", "verify-library-id.json"), "utf8");
    } catch (e) {}
  }
  const was = JSON.parse(before || "{}");
  const idx = await get("&section=all&length=1"), neu = await get("&recent=1");
  const first = neu.match(/<alb>([^<]*)<\/alb>\s*<art>([^<]*)<\/art>/);
  const now = {
    at: new Date().toISOString(),
    id: (idx.match(/<albums\b[^>]*\sid="(\d+)"/) || [])[1] || "",
    newId: (neu.match(/<albums\b[^>]*\sid="(\d+)"/) || [])[1] || "",
    albums: [...idx.matchAll(/<section name="[^"]*" length="(\d+)"/g)].reduce((n, m) => n + +m[1], 0),
    newest: first ? first[1] + " - " + first[2] : ""
  };
  bru.setVar("libWas", JSON.stringify(was));
  bru.setVar("libNow", JSON.stringify(now));
  const hex = (v) => v + " = 0x" + (+v).toString(16) + " (high " + (+v >>> 16) + ", low " + (+v & 0xffff) + ")";
  const diff = (k) => (was[k] === now[k] ? "unchanged " : "CHANGED " + was[k] + " -> ") + now[k];
  console.log("Since M39 (" + (was.at || "not run") + "):\n- id: " + (was.id === now.id ? "unchanged " + hex(now.id) : "CHANGED " + hex(was.id || "0") + " -> " + hex(now.id)) +
    "\n- albums: " + diff("albums") + "\n- newest: " + diff("newest") + "\n- id of New: " + now.newId);
}

tests {
  const was = JSON.parse(bru.getVar("libWas") || "{}");
  const now = JSON.parse(bru.getVar("libNow") || "{}");
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));
  test("M39 was run before", () => expect(was.id || "").to.match(/^\d+$/));
  test("id of New = id of the index", () => expect(now.newId).to.equal(now.id));
}
