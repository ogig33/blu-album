meta {
  name: M38 Upgrade log and versions of the group
  type: http
  seq: 38
}

get {
  url: http://{{host}}:80/Dataexport
  body: none
  auth: none
}

settings {
  encodeUrl: false
}

script:pre-request {
  // Manual requests run only with the environment variable runManual = true
  if (bru.getEnvVar("runManual") !== "true") { bru.runner.skipRequest(); return; }
  // Versions of every player of the group from the settings tree (settings "Version"); needs Developer mode (axios).
  const axios = require("axios");
  const H = "http://" + bru.getEnvVar("host") + ":11000";
  // The player's schema from /SyncStatus: without schemaVersion the tree is that of an old schema, without the version entries
  const sync = String((await axios.get(H + "/SyncStatus", { timeout: 15000, responseType: "text", transformResponse: (x) => x })).data || "");
  const schema = (sync.match(/\sschemaVersion="(\d+)"/) || [])[1] || "";
  const r = await axios.get(H + "/Settings?expand=1&schemaVersion=" + schema, { timeout: 15000, responseType: "text", transformResponse: (x) => x });
  const versions = [...String(r.data || "").matchAll(/<setting\b[^>]*id="([^"]*-version)"[^>]*value="([^"]*)"/g)].map((m) => m[1] + " = " + m[2]);
  bru.setVar("groupVersions", versions.join("\n"));
}

script:post-response {
  // System log of the player: only the lines of the upgrade (stage0 = upgrade service, stage1 / stage2 = upgrader) and the requests to /update and /upgrade
  const body = String(res.getBody() || "");
  const lines = body.split("\n").filter((l) => /stage[012]|upgrade|GET \/update|POST \/update|\/upgrade/i.test(l));
  const saveFixture = (file, text) => {
    if (bru.getEnvVar("saveFixtures") !== "true") return;
    try {
      const fs = require("fs"), path = require("path");
      const dir = path.join(bru.cwd(), "fixtures");
      fs.mkdirSync(dir, { recursive: true });
      fs.writeFileSync(path.join(dir, file), text);
    } catch (e) {
      console.log("Fixture not saved (switch the JavaScript sandbox to Developer mode): " + e.message);
    }
  };
  saveFixture("verify-upgrade-log.txt", lines.join("\n") + "\n\nVersions of the group:\n" + bru.getVar("groupVersions") + "\n");
  console.log("Versions of the group:\n" + bru.getVar("groupVersions") + "\n\nUpgrade lines of the log (last 60):\n" + lines.slice(-60).join("\n"));
}

tests {
  const body = String(res.getBody() || "");
  const from = bru.getVar("upgradeFrom"), to = bru.getVar("upgradeTo");
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));
  test("log names the upgrade " + from + " -> " + to, () => expect(body.includes("Start upgrade from " + from + " to " + to)).to.equal(true));
  test("every player of the group has the new version", () => {
    const vs = (bru.getVar("groupVersions") || "").split("\n").filter(Boolean);
    expect(vs.length).to.be.above(0);
    vs.forEach((v) => expect(v.endsWith("= " + to)).to.equal(true));
  });
}
