meta {
  name: M07 Reboot
  type: http
  seq: 7
}

post {
  url: http://{{host}}:80/reboot
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  yes: 1
}

settings {
  encodeUrl: false
}

script:pre-request {
  // Manual requests run only with the environment variable runManual = true
  if (bru.getEnvVar("runManual") !== "true") { bru.runner.skipRequest(); return; }
}

script:post-response {
  // Official: soft reboot, POST to port 80 with the form field yes (any value)
  const body = String(res.getBody() || "");
  const saveFixture = (file) => {
    if (bru.getEnvVar("saveFixtures") !== "true") return;
    try {
      const fs = require("fs"), path = require("path");
      const dir = path.join(bru.cwd(), "fixtures");
      fs.mkdirSync(dir, { recursive: true });
      fs.writeFileSync(path.join(dir, file), body);
    } catch (e) {
      console.log("Fixture not saved (switch the JavaScript sandbox to Developer mode): " + e.message);
    }
  };
  saveFixture("verify-reboot.html");
  bru.setVar("rebootAt", String(Date.now()));
  console.log("HTTP " + res.getStatus() + ", content-type: " + res.getHeader("content-type") + "\n" + body.slice(0, 2000));
}

tests {
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));
}
