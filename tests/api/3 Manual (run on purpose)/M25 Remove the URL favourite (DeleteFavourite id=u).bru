meta {
  name: M25 Remove the URL favourite (DeleteFavourite id=u)
  type: http
  seq: 25
}

get {
  url: http://{{host}}:11000/DeleteFavourite
  body: none
  auth: none
}

settings {
  encodeUrl: false
}

script:pre-request {
  // Manual requests run only with the environment variable runManual = true
  if (bru.getEnvVar("runManual") !== "true") { bru.runner.skipRequest(); return; }
  const del = JSON.parse(bru.getVar("vrUrlFavDel") || "[]");
  if (!del.length) { bru.runner.skipRequest(); return; }
  req.setUrl("http://" + bru.getEnvVar("host") + ":11000" + del[0]);
}

script:post-response {
  const body = String(res.getBody() || "");
  // Stores the answer in fixtures/ (needs Developer mode for the JavaScript sandbox)
  if (bru.getEnvVar("saveFixtures") === "true") {
    try {
      const fs = require("fs"), path = require("path");
      const dir = path.join(bru.cwd(), "fixtures");
      fs.mkdirSync(dir, { recursive: true });
      fs.writeFileSync(path.join(dir, "verify-delete-favourite-url.xml"), "<!-- " + req.getUrl().replace(/^https?:\/\/[^/]+/, "") + " -->\n" + body);
    } catch (e) {
      console.log("Fixture not saved (switch the JavaScript sandbox to Developer mode): " + e.message);
    }
  }
  console.log(req.getUrl() + "\n" + body);
  // Further copies of __bluos_verify__ (earlier runs)
  const axios = require("axios");
  const H = "http://" + bru.getEnvVar("host") + ":11000";
  const get = async (p) => String((await axios.get(H + p, { responseType: "text", transformResponse: (x) => x, validateStatus: () => true, timeout: 15000, headers: { "Accept-Language": "en" } })).data || "");
  const dec = (v) => v.replace(/&amp;/g, "&").replace(/&quot;/g, '"').replace(/&#39;/g, "'").replace(/&lt;/g, "<").replace(/&gt;/g, ">");
  const attr = (tag, n) => { const m = tag.match(new RegExp("\\s" + n + '="([^"]*)"')); return m ? dec(m[1]) : ""; };
  const tagsOf = (xml, name) => xml.match(new RegExp("<" + name + "\\b[^>]*>", "g")) || [];
  const browse = (key) => get("/Browse?key=" + encodeURIComponent(key));
  const stationOf = (t) => ((attr(t, "playURL").match(/[?&]url=([^&]*)/) || [])[1] || "");
  const menuAction = async (item, type) => { const t = item ? tagsOf(await browse(attr(item, "contextMenuKey")), "item").find((x) => attr(x, "type") === type) : ""; return t ? attr(t, "actionURL") : ""; };
  for (const u of JSON.parse(bru.getVar("vrUrlFavDel") || "[]").slice(1)) console.log(u + " -> " + (await get(u)).replace(/\s+/g, " ").slice(0, 120));
}

tests {
  const body = String(res.getBody() || "");
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));
  test("answer <favourite service=\"TuneIn\">deleted</favourite>", () => expect(/<favourite service="TuneIn">deleted<\/favourite>/.test(body)).to.equal(true));
}
