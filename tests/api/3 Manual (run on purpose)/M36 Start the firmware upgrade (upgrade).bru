meta {
  name: M36 Start the firmware upgrade (upgrade)
  type: http
  seq: 36
}

get {
  url: http://{{host}}:11000/update
  body: none
  auth: none
}

settings {
  encodeUrl: false
}

script:pre-request {
  // Manual requests run only with the environment variable runManual = true
  if (bru.getEnvVar("runManual") !== "true") { bru.runner.skipRequest(); return; }
  // Starts the firmware upgrade: the url of the button of the /update notification that is not the delay (M35, "I want it now").
  // Skipped without such a button. Sent with axios without following a redirect, so status, Location and body are recorded; needs Developer mode.
  const uri = bru.getVar("upgradeURI") || "";
  if (!uri) { bru.runner.skipRequest(); return; }
  const axios = require("axios");
  const H = "http://" + bru.getEnvVar("host") + ":11000";
  let out;
  try {
    const r = await axios.get(H + uri, { timeout: 30000, maxRedirects: 0, validateStatus: () => true, responseType: "text", transformResponse: (x) => x });
    out = { uri, status: r.status, location: r.headers.location || "", type: r.headers["content-type"] || "", body: String(r.data || "") };
  } catch (e) {
    out = { uri, status: 0, location: "", type: "", body: "request failed: " + e.message };
  }
  bru.setVar("upgradeAt", String(Date.now()));
  bru.setVar("upgradeTrigger", JSON.stringify(out));
}

script:post-response {
  // Main request: /update right after the trigger
  const t = JSON.parse(bru.getVar("upgradeTrigger") || "{}");
  const body = String(res.getBody() || "");
  const saveFixture = (file, text) => {
    if (bru.getEnvVar("saveFixtures") !== "true") return;
    try {
      const fs = require("fs"), path = require("path");
      const dir = path.join(bru.cwd(), "fixtures");
      fs.mkdirSync(dir, { recursive: true });
      fs.writeFileSync(path.join(dir, file), text);
    } catch (e) {
      console.log("Fixture not saved (switch the JavaScript sandbox to Developer mode): " + e.message);
    }
  };
  saveFixture("verify-upgrade-trigger.txt", "GET " + t.uri + "\nHTTP " + t.status + "\nLocation: " + t.location + "\nContent-Type: " + t.type + "\n\n" + t.body);
  saveFixture("verify-upgrade-message-after.xml", body);
  console.log("GET " + t.uri + " -> HTTP " + t.status + (t.location ? ", Location " + t.location : "") + "\n" + String(t.body).slice(0, 2000) + "\n/update afterwards: " + body);
}

tests {
  const t = JSON.parse(bru.getVar("upgradeTrigger") || "{}");
  test("/upgrade answers (200 or redirect)", () => expect([200, 301, 302, 303, 307]).to.include(t.status));
}
